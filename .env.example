# Copy to .env and adjust. docker compose reads it automatically.
DB_USER=english
DB_PASSWORD=english
DB_NAME=english_app

# Generate a strong value for production, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Set to true when serving over HTTPS
COOKIE_SECURE=false

# Optional: OAuth web client ID for "Sign in with Google" (empty = disabled)
GOOGLE_CLIENT_ID=

# Optional: Google Analytics 4 measurement ID (G-XXXXXXX). Only loaded after cookie consent.
GA_MEASUREMENT_ID=

# Public URL of the frontend, used for the links in emails
APP_URL=http://localhost:3000

# Emails are sent with Amazon SES (same account as bukios). Without AWS keys
# they are only written to the backend log, which is fine for development.
MAIL_FROM=Fluently <no-reply@bukios.com>
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

FRONTEND_PORT=3000
BACKEND_PORT=8080
