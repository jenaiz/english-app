              "lesson_id": "phrasal_verbs_hotel",
              "title": "Phrasal verbs: separable and inseparable",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "The Liffey House Hotel",
                    "dialogue": [
                      {
                        "speaker": "Receptionist",
                        "text": "Good evening, welcome to the Liffey House Hotel. Are you checking in?"
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Yes, we have a reservation under O'Brien."
                      },
                      {
                        "speaker": "Receptionist",
                        "text": "Lovely. Could you fill in this form, please? And I'll need to see your passports."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Of course. Here you are."
                      },
                      {
                        "speaker": "Receptionist",
                        "text": "Thank you. Breakfast is served from seven till ten, and check-out is at eleven."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Can we drop off our bags here tomorrow after we check out? Our train to Galway is at three."
                      },
                      {
                        "speaker": "Receptionist",
                        "text": "No problem, we'll look after them. Just pick them up before you leave."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Is the room quiet? I'm a light sleeper."
                      },
                      {
                        "speaker": "Receptionist",
                        "text": "Well, it faces the street, so it can be a bit noisy at weekends."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Don't worry, we can put up with a bit of noise."
                      },
                      {
                        "speaker": "Receptionist",
                        "text": "Room two one four, second floor. The lift is on your left. Enjoy your stay!"
                      }
                    ],
                    "passage": "That evening they arrive at a small hotel in the centre of Dublin, near the River Liffey."
                  }
                },
                {
