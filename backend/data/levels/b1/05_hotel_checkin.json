            {
              "lesson_id": "hotel_complaints",
              "title": "Polite complaints and requests",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "A polite complaint",
                    "dialogue": [
                      {
                        "speaker": "Lucía",
                        "text": "Good morning. I'm sorry to bother you, but I'm afraid there's a problem with our room."
                      },
                      {
                        "speaker": "Receptionist",
                        "text": "Oh dear. What seems to be the problem?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Well, the street was very noisy until three. Then this morning the shower didn't work."
                      },
                      {
                        "speaker": "Receptionist",
                        "text": "I'm so sorry about that."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "There was no hot water at all. Honestly, that was the last straw."
                      },
                      {
                        "speaker": "Receptionist",
                        "text": "I completely understand. Would you like to move to a quieter room?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "We're leaving today, actually. But would you mind sending someone to look at the shower?"
                      },
                      {
                        "speaker": "Receptionist",
                        "text": "Not at all. And let me take ten percent off your bill."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "That's very kind of you. Thank you."
                      },
                      {
                        "speaker": "Receptionist",
                        "text": "Could I offer you a free breakfast too?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Oh, that would be lovely. Daniel will be very happy about that!"
                      }
                    ],
                    "passage": "The next morning, Lucía goes down to reception. She hasn't slept much."
                  }
                },
                {
                  "phase": "discovery",
                  "type": "multiple_choice",
                  "content": {
                    "instructions": "Fíjate en el diálogo y responde.",
                    "items": [
                      {
                        "question": "\"I'm sorry to bother you, but…\" is used to…",
                        "options": [
                          "start a request politely",
                          "end a conversation"
                        ],
                        "answer": 0
                      },
                      {
                        "question": "\"Would you mind sending someone?\" After would you mind we use…",
                        "options": [
                          "-ing",
                          "to + verb"
                        ],
                        "answer": 0
                      },
                      {
                        "question": "\"I'm afraid there's a problem.\" I'm afraid here means…",
                        "options": [
                          "lo siento, pero…; me temo que…",
                          "tengo miedo"
                        ],
                        "answer": 0
