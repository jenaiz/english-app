                {
                  "phase": "grammar",
                  "type": "grammar_rule",
                  "content": {
                    "title": "must, mustn't, have to, don't need to, can",
                    "explanation": "Must expresa obligación, sobre todo en normas o cuando la impone quien habla: The new flatmate must be clean and quiet. Have to también expresa obligación (a menudo externa) y en pasado se convierte en had to.\n\nAtención a la gran diferencia:\n• mustn't = está prohibido: They mustn't smoke in the house.\n• don't have to / don't need to = no es necesario: You don't need to put an advert online.\n\nCan / can't expresan permiso: Can they have a pet? — No, you can't have pets.",
                    "table": {
                      "headers": [
                        "Modal",
                        "Significado",
                        "Ejemplo"
                      ],
                      "rows": [
                        [
                          "must",
                          "obligación (norma)",
                          "The new flatmate must be clean and quiet."
                        ],
                        [
                          "have to / has to",
                          "obligación",
                          "Everyone has to pay a deposit."
                        ],
                        [
                          "mustn't",
                          "prohibición",
                          "They mustn't smoke in the house."
                        ],
                        [
                          "don't have to / don't need to",
                          "no es necesario",
                          "You don't need to put an advert online."
                        ],
                        [
                          "can",
                          "permiso",
                          "You can ask him."
                        ],
                        [
                          "can't",
                          "no está permitido",
                          "You can't have pets."
                        ],
                        [
                          "had to",
                          "obligación en pasado",
                          "You had to pay one too, Sam!"
                        ]
                      ]
                    },
                    "examples": [
                      "The new flatmate must be clean and quiet.",
                      "They mustn't smoke in the house.",
                      "Everyone has to pay a deposit.",
                      "You don't need to put an advert online."
                    ]
                  }
