          "unit_id": "house_rules",
          "title": "House Rules",
          "description": "Normas, prohibiciones y lo que no hace falta: must, mustn't, have to, don't need to, can.",
          "lessons": [
            {
              "lesson_id": "house_rules_lesson",
              "title": "must, mustn't, have to, don't need to, can",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "House rules",
                    "dialogue": [
                      {
                        "speaker": "Mrs Green",
                        "text": "Now, the new flatmate must be clean and quiet. That's the first rule."
                      },
                      {
                        "speaker": "Priya",
                        "text": "Of course. They'll have to share the kitchen with us."
                      },
                      {
                        "speaker": "Mrs Green",
                        "text": "And they mustn't smoke in the house. Nobody smokes in my houses."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Can they have a pet? I'd love a cat."
                      },
                      {
                        "speaker": "Mrs Green",
                        "text": "No, I'm afraid you can't have pets. The neighbours are allergic."
                      },
                      {
                        "speaker": "Sam",
                        "text": "Do they have to pay a deposit?"
                      },
                      {
                        "speaker": "Mrs Green",
                        "text": "Yes. Everyone has to pay one month's rent as a deposit. You did too, Sam!"
                      },
                      {
                        "speaker": "Sam",
                        "text": "And can they play music?"
                      },
                      {
                        "speaker": "Mrs Green",
                        "text": "Not after eleven o'clock. You know that better than anyone!"
                      },
                      {
                        "speaker": "Priya",
                        "text": "Do we need to put an advert online?"
                      },
                      {
                        "speaker": "Mrs Green",
                        "text": "You don't need to. My nephew Ollie is looking for a room. He's a chef."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "A chef? Then he must cook for us!"
                      },
                      {
                        "speaker": "Mrs Green",
                        "text": "Ha! Well, you can ask him."
                      }
                    ],
                    "passage": "June. Mrs Green comes to Clifton Road to talk about finding a new flatmate before Sam leaves."
                  }
                },
