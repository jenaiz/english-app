          "unit_id": "farewell_gig",
          "title": "The Farewell Gig",
          "description": "Cuenta una historia con orden: past simple, past continuous y past perfect.",
          "lessons": [
            {
              "lesson_id": "farewell_gig_lesson",
              "title": "Past perfect and narrative tenses",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "The farewell gig",
                    "dialogue": [
                      {
                        "speaker": "Priya",
                        "text": "So, how was it? I'm so sorry I missed it."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "It was crazy! When we arrived, the band had already started."
                      },
                      {
                        "speaker": "Priya",
                        "text": "Already? Why were you late?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Daniel had left the tickets at home, so we had to go back."
                      },
                      {
                        "speaker": "Priya",
                        "text": "Typical! And how was Sam?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Nervous at first. He had never played in front of so many people."
                      },
                      {
                        "speaker": "Priya",
                        "text": "Was the producer there?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Yes, he had come from London to see them. And in the middle of the concert, the electricity went off!"
                      },
                      {
                        "speaker": "Priya",
                        "text": "No! What did they do?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Luckily, Sam had brought his old guitar, so he played without electricity. Everyone was singing!"
                      },
                      {
                        "speaker": "Priya",
                        "text": "That's so Sam. Did he cry?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "A bit. He said it was the best night of his life."
                      }
                    ],
                    "passage": "Saturday night was Sam's farewell gig at The Old Duke. Priya missed it because she was working, so on Sunday morning Lucía tells her everything."
                  }
                },
