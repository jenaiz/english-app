              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "A big decision",
                    "dialogue": [
                      {
                        "speaker": "Sam",
                        "text": "They want us in London for six months. Six months!"
                      },
                      {
                        "speaker": "Priya",
                        "text": "Sam, that's amazing! So why do you look so worried?"
                      },
                      {
                        "speaker": "Sam",
                        "text": "If I went, I'd have to leave the pub, and the house. And you two."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "If I were you, I'd go. It's your dream."
                      },
                      {
                        "speaker": "Sam",
                        "text": "But what would I do if it didn't work?"
                      },
                      {
                        "speaker": "Priya",
                        "text": "If it didn't work, you'd come back. Mrs Green would give you your room again."
                      },
                      {
                        "speaker": "Sam",
                        "text": "Would you miss me?"
                      },
                      {
                        "speaker": "Priya",
                        "text": "Miss you? If you left, the kitchen would be much tidier!"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "We'd miss you a lot. Who would make chicken soup when I'm ill?"
                      },
                      {
                        "speaker": "Sam",
                        "text": "OK. If you promise to visit me, I'll go."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Of course we'll visit!"
                      },
                      {
                        "speaker": "Priya",
                        "text": "But we'll need a new flatmate…"
                      }
                    ],
                    "passage": "May. Sam comes home with big news. The music producer from February wants his band to record an album in London."
                  }
                },
                {
