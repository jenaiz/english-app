{
  "level_id": "B1",
  "themes": [
    {
      "theme_id": "travel_accommodation",
      "units": [
        {
          "unit_id": "hotel_checkin",
          "title": "Checking into a Hotel & Complaints",
          "description": "Aprende phrasal verbs y vocabulario para gestionar tu estancia.",
          "lessons": [
            {
              "lesson_id": "phrasal_verbs_hotel",
              "title": "Phrasal Verbs for Hotel Stay",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "dialogue": [
                      {
                        "speaker": "Receptionist",
                        "text": "Good afternoon, how can I help you?"
                      },
                      {
                        "speaker": "Guest",
                        "text": "Hi, I'd like to check in, please. I booked a double room."
                      },
                      {
                        "speaker": "Receptionist",
                        "text": "Of course. Could you fill in this form? Breakfast is from seven to ten."
                      },
                      {
                        "speaker": "Guest",
                        "text": "Great. And what time do we need to check out?"
                      },
                      {
                        "speaker": "Receptionist",
                        "text": "Check-out is at noon. Please turn off the air conditioning when you go out."
                      },
                      {
                        "speaker": "Guest",
                        "text": "Sure. Can you pick us up from the station tomorrow?"
                      },
                      {
                        "speaker": "Receptionist",
                        "text": "Yes, we can pick you up at nine. Enjoy your stay!"
                      }
                    ]
                  }
                },
                {
                  "phase": "discovery",
                  "type": "match_pairs",
                  "content": {
                    "instructions": "Empareja cada phrasal verb del diálogo con su significado.",
                    "pairs": [
                      {
                        "left": "Check in",
                        "right": "Registrarse"
                      },
                      {
                        "left": "Check out",
                        "right": "Dejar la habitación"
                      },
                      {
                        "left": "Fill in",
                        "right": "Rellenar"
                      },
                      {
                        "left": "Turn off",
                        "right": "Apagar"
                      },
                      {
                        "left": "Pick up",
                        "right": "Recoger"
                      }
                    ]
                  }
                },
                {
                  "phase": "discovery",
                  "type": "multiple_choice",
                  "content": {
                    "instructions": "Fíjate en dónde va el objeto.",
                    "items": [
                      {
                        "question": "\"We can pick ___ up at nine.\" The receptionist said…",
                        "options": [
                          "you",
                          "up you",
                          "your"
                        ],
                        "answer": 0,
                        "explanation": "Con pronombre, el objeto va en medio: pick you up."
                      },
                      {
                        "question": "Which sentence is correct?",
                        "options": [
                          "I'd like to check the hotel in",
                          "I'd like to check in the hotel",
                          "I'd like to check in"
                        ],
                        "answer": 2
                      }
                    ]
                  }
                },
                {
                  "phase": "grammar",
                  "type": "grammar_rule",
                  "content": {
                    "title": "Phrasal Verbs: Separables vs Inseparables",
                    "explanation": "Algunos phrasal verbs no llevan objeto (check in, go out). Los separables (turn off, fill in, pick up) permiten poner el objeto en medio o al final, PERO si el objeto es un pronombre (it, them, you…) tiene que ir en medio.",
                    "table": {
                      "headers": [
                        "Objeto",
                        "Posición",
                        "Ejemplo"
                      ],
                      "rows": [
                        [
                          "Sustantivo",
                          "En medio o al final",
                          "Turn off the light / Turn the light off"
                        ],
                        [
                          "Pronombre",
                          "Solo en medio",
                          "Turn it off (✗ Turn off it)"
                        ],
                        [
                          "Sin objeto",
                          "—",
                          "We checked in at 3 PM."
                        ]
                      ]
                    },
                    "examples": [
                      "Could you fill in this form? / Could you fill this form in?",
                      "Can you fill it in, please?",
                      "We'll pick them up at nine."
                    ]
                  }
                },
                {
                  "phase": "practice",
                  "type": "fill_blanks",
                  "content": {
                    "instructions": "Completa con la partícula correcta (in, out, off, up).",
                    "items": [
                      {
                        "sentence": "We have to check ___ by noon.",
                        "answers": [
                          [
                            "out"
                          ]
                        ]
                      },
                      {
                        "sentence": "Please fill ___ your passport number.",
                        "answers": [
                          [
                            "in"
                          ]
                        ]
                      },
                      {
                        "sentence": "Don't forget to turn the lights ___.",
                        "answers": [
                          [
                            "off"
                          ]
                        ]
                      },
                      {
                        "sentence": "The taxi will pick us ___ at nine.",
                        "answers": [
                          [
                            "up"
                          ]
                        ]
                      }
                    ]
                  }
                },
                {
                  "phase": "practice",
                  "type": "transformation",
                  "content": {
                    "instructions": "Sustituye el objeto por un pronombre (it / them).",
                    "items": [
                      {
                        "prompt": "the TV → it",
                        "source": "Turn off the TV.",
                        "answers": [
                          "Turn it off"
                        ],
                        "explanation": "Pronombre siempre en medio: turn it off."
                      },
                      {
                        "prompt": "the form → it",
                        "source": "Fill in the form.",
                        "answers": [
                          "Fill it in"
                        ]
                      },
                      {
                        "prompt": "the guests → them",
                        "source": "Pick up the guests.",
                        "answers": [
                          "Pick them up"
                        ]
                      }
                    ]
                  }
                },
                {
                  "phase": "practice",
                  "type": "word_order",
                  "content": {
                    "instructions": "Ordena la frase.",
                    "items": [
                      {
                        "answer": "Could you turn it off?",
                        "distractors": [
                          "on"
                        ]
                      },
                      {
                        "answer": "We checked in at three"
                      }
                    ]
                  }
                },
                {
                  "phase": "production",
                  "type": "translation",
                  "content": {
                    "instructions": "Traduce al inglés.",
                    "items": [
                      {
                        "source": "¿Puedes rellenarlo?",
                        "answers": [
                          "Can you fill it in?",
                          "Could you fill it in?",
                          "Can you fill it out?",
                          "Could you fill it out?"
                        ]
                      },
                      {
                        "source": "Nos registramos a las tres.",
                        "answers": [
                          "We checked in at three",
                          "We checked in at 3",
                          "We check in at three"
                        ]
                      }
                    ]
                  }
                },
                {
                  "phase": "production",
                  "type": "speaking",
                  "content": {
                    "instructions": "Lee en voz alta como si estuvieras en recepción.",
                    "items": [
                      {
                        "text": "Hi, I'd like to check in, please."
                      },
                      {
                        "text": "What time do we need to check out?"
                      }
                    ]
                  }
                },
                {
                  "phase": "vocabulary",
                  "type": "vocabulary_table",
                  "content": {
                    "items": [
                      {
                        "term": "Check in",
                        "definition": "Arrive and register at a hotel",
                        "translation": "Registrarse",
                        "example": "We checked in at 3 PM."
                      },
                      {
                        "term": "Check out",
                        "definition": "Pay and leave a hotel",
                        "translation": "Dejar la habitación",
                        "example": "We have to check out by noon."
                      },
                      {
                        "term": "Fill in",
                        "definition": "Complete a form with information",
                        "translation": "Rellenar",
                        "example": "Please fill in your passport number."
                      },
                      {
                        "term": "Turn off",
                        "definition": "Stop a device working",
                        "translation": "Apagar",
                        "example": "Turn off the air conditioning when you leave."
                      },
                      {
                        "term": "Pick up",
                        "definition": "Collect someone by car",
                        "translation": "Recoger",
                        "example": "We'll pick you up at nine."
                      }
                    ]
                  }
                },
                {
                  "phase": "review",
                  "type": "speed_quiz",
                  "content": {
                    "instructions": "¡Contrarreloj!",
                    "time_limit_seconds": 40,
                    "items": [
                      {
                        "question": "Correct:",
                        "options": [
                          "Turn off it",
                          "Turn it off",
                          "Turn it of"
                        ],
                        "answer": 1
                      },
                      {
                        "question": "\"Rellenar un formulario\" =",
                        "options": [
                          "fill in a form",
                          "fill up a form",
                          "check in a form"
                        ],
                        "answer": 0
                      },
                      {
                        "question": "We need to ___ by 12.",
                        "options": [
                          "check out",
                          "check off",
                          "check up"
                        ],
                        "answer": 0
                      },
                      {
                        "question": "\"Recoger a alguien\" =",
                        "options": [
                          "pick up",
                          "turn up",
                          "fill up"
                        ],
                        "answer": 0
                      }
                    ]
                  }
                }
              ]
            },
            {
              "lesson_id": "hotel_complaints",
              "title": "Making a Polite Complaint",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "dialogue": [
                      {
                        "speaker": "Guest",
                        "text": "Excuse me, I'm afraid there's a problem with my room."
                      },
                      {
                        "speaker": "Receptionist",
                        "text": "I'm sorry to hear that. What seems to be the problem?"
                      },
                      {
                        "speaker": "Guest",
                        "text": "The heating isn't working and the room is freezing. Would it be possible to change rooms?"
                      },
                      {
                        "speaker": "Receptionist",
                        "text": "I apologise. I'll send someone up right away, or we can move you to another room."
                      },
                      {
                        "speaker": "Guest",
                        "text": "I was wondering if you could also give us a discount for tonight."
                      }
                    ]
                  }
                },
                {
                  "phase": "discovery",
                  "type": "multiple_choice",
                  "content": {
                    "instructions": "¿Cómo suaviza el cliente sus quejas?",
                    "items": [
                      {
                        "question": "Which phrase does the guest use to introduce the problem politely?",
                        "options": [
                          "I'm afraid…",
                          "You must…",
                          "Listen!"
                        ],
                        "answer": 0
                      },
                      {
                        "question": "\"Would it be possible to change rooms?\" is…",
                        "options": [
                          "An order",
                          "A polite request",
                          "A threat"
                        ],
                        "answer": 1
                      },
                      {
                        "question": "After \"I was wondering if you could…\" comes…",
                        "options": [
                          "the infinitive without 'to'",
                          "the -ing form",
                          "a past participle"
                        ],
                        "answer": 0,
                        "explanation": "could + infinitivo sin 'to': could give, could send…"
                      }
                    ]
                  }
                },
                {
                  "phase": "grammar",
                  "type": "grammar_rule",
                  "content": {
                    "title": "Softening Complaints",
                    "explanation": "En inglés las quejas suenan mucho más educadas si se suavizan. Usamos fórmulas indirectas que preceden a la petición.",
                    "table": {
                      "headers": [
                        "Directo (brusco)",
                        "Suavizado (educado)"
                      ],
                      "rows": [
                        [
                          "The shower doesn't work.",
                          "I'm afraid the shower doesn't work."
                        ],
                        [
                          "Change my room.",
                          "Would it be possible to change rooms?"
                        ],
                        [
                          "Give me more towels.",
                          "I was wondering if you could send up some towels."
                        ],
                        [
                          "Turn the music down.",
                          "Would you mind turning the music down?"
                        ]
                      ]
                    },
                    "examples": [
                      "I'm afraid there's a problem with the bill.",
                      "Would you mind checking it again?"
                    ]
                  }
                },
                {
                  "phase": "practice",
                  "type": "fill_blanks",
                  "content": {
                    "instructions": "Completa la fórmula educada.",
                    "items": [
                      {
                        "sentence": "I'm ___ the Wi-Fi isn't working.",
                        "answers": [
                          [
                            "afraid"
                          ]
                        ]
                      },
                      {
                        "sentence": "Would it be ___ to have a late check-out?",
                        "answers": [
                          [
                            "possible"
                          ]
                        ]
                      },
                      {
                        "sentence": "Would you mind ___ (turn) the music down?",
                        "answers": [
                          [
                            "turning"
                          ]
                        ],
                        "explanation": "Would you mind + -ing."
                      },
                      {
                        "sentence": "I was ___ if you could help me.",
                        "answers": [
                          [
                            "wondering"
                          ]
                        ]
                      }
                    ]
                  }
                },
                {
                  "phase": "practice",
                  "type": "transformation",
                  "content": {
                    "instructions": "Convierte la queja directa en una educada.",
                    "items": [
                      {
                        "prompt": "Usa 'Would it be possible to…?'",
                        "source": "Change my room.",
                        "answers": [
                          "Would it be possible to change my room?",
                          "Would it be possible to change rooms?"
                        ]
                      },
                      {
                        "prompt": "Usa 'Would you mind…?'",
                        "source": "Close the window.",
                        "answers": [
                          "Would you mind closing the window?"
                        ]
                      }
                    ]
                  }
                },
                {
                  "phase": "production",
                  "type": "speaking",
                  "content": {
                    "instructions": "Haz la queja en voz alta, con educación.",
                    "items": [
                      {
                        "text": "I'm afraid there's a problem with my room."
                      },
                      {
                        "text": "Would it be possible to change rooms?"
                      }
                    ]
                  }
                },
                {
                  "phase": "production",
                  "type": "dictation",
                  "content": {
                    "instructions": "Escucha y escribe.",
                    "items": [
                      {
                        "text": "I was wondering if you could send up some extra towels."
                      }
                    ]
                  }
                },
                {
                  "phase": "vocabulary",
                  "type": "vocabulary_table",
                  "content": {
                    "items": [
                      {
                        "term": "Complaint",
                        "definition": "A statement that something is wrong",
                        "translation": "Queja",
                        "example": "I'd like to make a complaint."
                      },
                      {
                        "term": "Refund",
                        "definition": "Money returned to you",
                        "translation": "Reembolso",
                        "example": "Can I get a refund for the first night?"
                      },
                      {
                        "term": "Noisy",
                        "definition": "Making a lot of noise",
                        "translation": "Ruidoso",
                        "example": "The room next door is very noisy."
                      },
                      {
                        "term": "Freezing",
                        "definition": "Extremely cold",
                        "translation": "Helado",
                        "example": "The room is freezing."
                      },
                      {
                        "term": "Discount",
                        "definition": "A reduction in price",
                        "translation": "Descuento",
                        "example": "Could you give us a discount?"
                      }
                    ]
                  }
                },
                {
                  "phase": "review",
                  "type": "speed_quiz",
                  "content": {
                    "instructions": "¡Contrarreloj!",
                    "time_limit_seconds": 35,
                    "items": [
                      {
                        "question": "Would you mind ___ the door?",
                        "options": [
                          "close",
                          "closing",
                          "to close"
                        ],
                        "answer": 1
                      },
                      {
                        "question": "\"Reembolso\" =",
                        "options": [
                          "refund",
                          "discount",
                          "receipt"
                        ],
                        "answer": 0
                      },
                      {
                        "question": "Most polite:",
                        "options": [
                          "Fix the heating.",
                          "I'm afraid the heating isn't working.",
                          "The heating is broken!"
                        ],
                        "answer": 1
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
