{
  "level_id": "B1",
  "themes": [
    {
      "theme_id": "travel_accommodation",
      "units": [
        {
          "unit_id": "airport_travel",
          "title": "At the Airport",
          "description": "Vocabulario y expresiones para facturar, embarcar y resolver imprevistos.",
          "lessons": [
            {
              "lesson_id": "airport_checkin",
              "title": "Check-in and Boarding",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "dialogue": [
                      {
                        "speaker": "Agent",
                        "text": "Can I see your passport and boarding pass, please?"
                      },
                      {
                        "speaker": "Passenger",
                        "text": "Here you are. I'd like to drop off this suitcase."
                      },
                      {
                        "speaker": "Agent",
                        "text": "Your flight has been delayed by forty minutes. Boarding starts at gate 12."
                      },
                      {
                        "speaker": "Passenger",
                        "text": "Has the gate been announced yet?"
                      },
                      {
                        "speaker": "Agent",
                        "text": "Yes, it has. The plane will take off at nine fifteen."
                      }
                    ]
                  }
                },
                {
                  "phase": "discovery",
                  "type": "match_pairs",
                  "content": {
                    "instructions": "Empareja cada término con su traducción.",
                    "pairs": [
                      {
                        "left": "Boarding pass",
                        "right": "Tarjeta de embarque"
                      },
                      {
                        "left": "Delayed",
                        "right": "Retrasado"
                      },
                      {
                        "left": "Take off",
                        "right": "Despegar"
                      },
                      {
                        "left": "Gate",
                        "right": "Puerta de embarque"
                      }
                    ]
                  }
                },
                {
                  "phase": "grammar",
                  "type": "grammar_rule",
                  "content": {
                    "title": "Passive voice in announcements",
                    "explanation": "En aeropuertos se usa mucho la voz pasiva porque importa lo que pasa, no quién lo hace. Se forma con 'to be' + participio.",
                    "table": {
                      "headers": [
                        "Tiempo",
                        "Pasiva",
                        "Ejemplo"
                      ],
                      "rows": [
                        [
                          "Present simple",
                          "is / are + participio",
                          "Passengers are asked to go to gate 12."
                        ],
                        [
                          "Present perfect",
                          "has / have been + participio",
                          "Your flight has been delayed."
                        ],
                        [
                          "Past simple",
                          "was / were + participio",
                          "The flight was cancelled."
                        ]
                      ]
                    },
                    "examples": [
                      "Bags are checked at desk 4.",
                      "The gate has been changed."
                    ]
                  }
                },
                {
                  "phase": "practice",
                  "type": "fill_blanks",
                  "content": {
                    "instructions": "Completa con la pasiva correcta.",
                    "items": [
                      {
                        "sentence": "Your flight has ___ delayed.",
                        "answers": [
                          [
                            "been"
                          ]
                        ]
                      },
                      {
                        "sentence": "Passengers ___ asked to switch off their phones.",
                        "answers": [
                          [
                            "are"
                          ]
                        ]
                      },
                      {
                        "sentence": "Yesterday the flight ___ cancelled.",
                        "answers": [
                          [
                            "was"
                          ]
                        ]
                      }
                    ]
                  }
                },
                {
                  "phase": "practice",
                  "type": "word_order",
                  "content": {
                    "instructions": "Ordena el anuncio.",
                    "items": [
                      {
                        "answer": "The gate has been changed"
                      },
                      {
                        "answer": "Your flight has been delayed by forty minutes"
                      }
                    ]
                  }
                },
                {
                  "phase": "production",
                  "type": "dictation",
                  "content": {
                    "instructions": "Escucha el anuncio y escríbelo.",
                    "items": [
                      {
                        "text": "Flight BA246 has been delayed."
                      },
                      {
                        "text": "Passengers are asked to go to gate twelve."
                      }
                    ]
                  }
                },
                {
                  "phase": "production",
                  "type": "translation",
                  "content": {
                    "instructions": "Traduce al inglés.",
                    "items": [
                      {
                        "source": "Mi vuelo ha sido cancelado.",
                        "answers": [
                          "My flight has been cancelled",
                          "My flight has been canceled"
                        ]
                      }
                    ]
                  }
                },
                {
                  "phase": "vocabulary",
                  "type": "vocabulary_table",
                  "content": {
                    "items": [
                      {
                        "term": "Boarding pass",
                        "definition": "Document that lets you get on a plane",
                        "translation": "Tarjeta de embarque",
                        "example": "Have your boarding pass ready."
                      },
                      {
                        "term": "Delayed",
                        "definition": "Later than planned",
                        "translation": "Retrasado",
                        "example": "Our flight was delayed."
                      },
                      {
                        "term": "Take off",
                        "definition": "When a plane leaves the ground",
                        "translation": "Despegar",
                        "example": "The plane takes off at 9 PM."
                      },
                      {
                        "term": "Drop off",
                        "definition": "Leave something somewhere",
                        "translation": "Dejar / facturar",
                        "example": "I need to drop off my suitcase."
                      },
                      {
                        "term": "Gate",
                        "definition": "Where you board the plane",
                        "translation": "Puerta de embarque",
                        "example": "Go to gate 12."
                      }
                    ]
                  }
                },
                {
                  "phase": "review",
                  "type": "speed_quiz",
                  "content": {
                    "instructions": "¡Contrarreloj!",
                    "time_limit_seconds": 35,
                    "items": [
                      {
                        "question": "The flight has ___ cancelled.",
                        "options": [
                          "be",
                          "been",
                          "being"
                        ],
                        "answer": 1
                      },
                      {
                        "question": "\"Despegar\" =",
                        "options": [
                          "take off",
                          "drop off",
                          "turn off"
                        ],
                        "answer": 0
                      },
                      {
                        "question": "Bags ___ checked at desk 4.",
                        "options": [
                          "is",
                          "are",
                          "be"
                        ],
                        "answer": 1
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
