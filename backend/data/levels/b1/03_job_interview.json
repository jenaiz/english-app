                          "outside"
                        ],
                        "answer": 0
                      },
                      {
                        "question": "___ you ever been to Japan?",
                        "options": [
                          "Did",
                          "Have",
                          "Are"
                        ],
                        "answer": 1
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
