          "unit_id": "the_pitch",
          "title": "The Pitch",
          "description": "Da énfasis como un nativo: do / did enfático, such / so y anteposición.",
          "lessons": [
            {
              "lesson_id": "the_pitch_lesson",
              "title": "Emphasis: do, such, so and fronting",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "The pitch",
                    "dialogue": [
                      {
                        "speaker": "Mark",
                        "text": "I do have to say, that was impressive."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Thank you. We did prepare quite carefully."
                      },
                      {
                        "speaker": "Mark",
                        "text": "Such a small studio, and yet such ambitious plans. What surprises me is the Madrid office."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Madrid is where I started my career. I do know that market very well."
                      },
                      {
                        "speaker": "Mark",
                        "text": "So convincing were your numbers that my finance director stopped taking notes."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "The numbers are real, Mark. Every single one."
                      },
                      {
                        "speaker": "Mark",
                        "text": "Oh, I don't doubt it. What I'm proposing is simple: we invest, and you design all our European hotels."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "That's a very generous offer. It does come with conditions, I assume?"
                      },
                      {
                        "speaker": "Mark",
                        "text": "Just one. Grace Walker stays on board. I've heard such good things about her."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "That we can promise. Grace is the reason we're here."
                      },
                      {
                        "speaker": "Mark",
                        "text": "Then it's a deal. And Lucía? Helen was right about you."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Helen usually is."
                      }
                    ],
                    "passage": "The next morning, in Reed Hotels' boardroom, forty floors above Manhattan. Lucía has just finished presenting. Mark leans back in his chair."
                  }
                },
                {
                  "phase": "discovery",
                  "type": "multiple_choice",
                  "content": {
