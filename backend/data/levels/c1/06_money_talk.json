              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "Terms and conditions",
                    "dialogue": [
                      {
                        "speaker": "Grace",
                        "text": "I'm prepared to invest, provided that I get a seat on the board."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "As long as we keep creative control, that seems fair."
                      },
                      {
                        "speaker": "Grace",
                        "text": "You'll keep it, on condition that the studio grows by thirty percent next year."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Supposing we don't reach thirty percent, what happens then?"
                      },
                      {
                        "speaker": "Grace",
                        "text": "Then we'd sit down and talk. Unless something drastic happened, I wouldn't pull out."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "But for your pilot project, we'd never have got this far."
                      },
                      {
                        "speaker": "Grace",
                        "text": "And but for your designs, my bookings wouldn't have doubled."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "There's one more thing. Mark Reed has invited us to pitch in New York in May."
                      },
                      {
                        "speaker": "Grace",
                        "text": "Go. Otherwise, you'll always wonder. Should he make an offer, though, tell me first."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Of course. Assuming everything goes well, we'll be back with good news."
                      },
                      {
                        "speaker": "Grace",
                        "text": "In that case, I'll draw up the contract."
                      }
                    ],
                    "passage": "April. Grace is so happy with the results that she wants to invest in Green Door Design. Lucía and Daniel meet her to discuss the terms."
                  }
