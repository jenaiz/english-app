            {
              "lesson_id": "first_client_lesson",
              "title": "Hedging and softening",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "The first client",
                    "dialogue": [
                      {
                        "speaker": "Grace",
                        "text": "I'll be honest with you. It would appear that your prices are rather higher than your competitors'."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "That may well be the case. However, our designs tend to bring in considerably more bookings."
                      },
                      {
                        "speaker": "Grace",
                        "text": "Arguably, that depends on the market. Our guests are mostly students."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "To some extent, yes. But there seems to be a clear link between good design and trust, even among younger travellers."
                      },
                      {
                        "speaker": "Grace",
                        "text": "I'm not entirely convinced. Do you have any evidence?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "We'd suggest a small pilot. It might be worth testing one hostel first."
                      },
                      {
                        "speaker": "Grace",
                        "text": "That sounds reasonable, I suppose. What would that cost?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Roughly a quarter of the full project. If the results are good, we'd continue."
                      },
                      {
                        "speaker": "Grace",
                        "text": "It seems to me that you're quite confident."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Cautiously confident, let's say."
                      },
                      {
                        "speaker": "Grace",
                        "text": "I like that. Let's give it a go."
                      }
                    ],
                    "passage": "February. Green Door Design has its first meeting with a potential client: Grace Walker, an Australian businesswoman who runs a chain of eco-friendly hostels."
                  }
