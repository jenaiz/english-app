      "units": [
        {
          "unit_id": "the_engagement",
          "title": "The Engagement Party",
          "description": "Habla como un nativo sin repetir: elipsis y sustitución (I hope so, So would I, If you want me to). Además, el lenguaje aproximativo: sort of, or so, -ish, or something.",
          "lessons": [
            {
              "lesson_id": "the_engagement_lesson",
              "title": "Ellipsis and substitution",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "The engagement party",
                    "dialogue": [
                      {
                        "speaker": "Sam",
                        "text": "Priya! Congratulations! Did you know he was going to propose?"
                      },
                      {
                        "speaker": "Priya",
                        "text": "I hoped so, but I didn't expect it to happen in the middle of the hospital."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "In the hospital? I'd have loved to see that."
                      },
                      {
                        "speaker": "Priya",
                        "text": "So would half the nurses. They all came out to watch."
                      },
                      {
                        "speaker": "Sam",
                        "text": "Are you having a big wedding?"
                      },
                      {
                        "speaker": "Priya",
                        "text": "I think so. My mum wants five hundred guests. I'd rather not."
                      },
                      {
                        "speaker": "Ollie",
                        "text": "Who's cooking? Me, I hope."
                      },
                      {
                        "speaker": "Priya",
                        "text": "If you'd like to."
                      },
                      {
                        "speaker": "Ollie",
                        "text": "I would. Indian and Spanish fusion, like this house."
                      },
                      {
                        "speaker": "Sam",
                        "text": "And the band could play, if you want us to."
                      },
                      {
                        "speaker": "Priya",
                        "text": "Of course I want you to! Lucía, you'll be my bridesmaid, won't you?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Of course I will. Have you chosen a date?"
                      },
                      {
                        "speaker": "Priya",
                        "text": "Not yet. Next summer, probably. Have you and Daniel?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Have we what?"
                      },
                      {
                        "speaker": "Priya",
                        "text": "Chosen a date!"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "We're not engaged, Priya! Are we, Daniel?"
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Not yet."
                      }
                    ],
                    "passage": "June. Priya has just got engaged to Arjun, a doctor from her hospital, and there's a party at Clifton Road. Sam is back from his European tour."
                  }
                },
                {
                  "phase": "discovery",
                  "type": "multiple_choice",
                  "content": {
                    "instructions": "Fíjate en el diálogo y responde.",
                    "items": [
                      {
                        "question": "\"I hoped so.\" So replaces…",
                        "options": [
