        {
          "unit_id": "the_offer",
          "title": "What Keeps Me Awake",
          "description": "Pon el foco donde quieres: cleft sentences (What I need is…, It was you who…).",
          "lessons": [
            {
              "lesson_id": "the_offer_lesson",
              "title": "Cleft sentences",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "What keeps me awake",
                    "dialogue": [
                      {
                        "speaker": "Daniel",
                        "text": "You've been staring at that ceiling for an hour. What's on your mind?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "What I keep asking myself is whether I'm ready."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Ready for what, exactly? Running a studio, or saying no to Mark?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "It's not Mark I'm worried about. It's the clients. What if they follow Helen's name, not mine?"
                      },
                      {
                        "speaker": "Daniel",
                        "text": "The thing is, they already ask for you. It was you who saved the museum project, not Helen."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "It was both of us. What Helen gave me was the chance."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "And what you did with it was impressive. All I'm saying is, don't let fear decide for you."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "What scares me most is the money. I'd be risking everything we've saved."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "The reason I'm not worried is that you never do anything without a plan."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "That's true. Where I'd really need help is the technical side."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Then it's me you need. I'm not going anywhere."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Are you offering to leave Harbour Studio?"
                      },
                      {
                        "speaker": "Daniel",
                        "text": "What I'm offering is a partner. If you'll have me."
                      }
                    ],
                    "passage": "July, year three. Lucía and Daniel have just moved into a flat near the harbour. There are boxes everywhere, and Lucía hasn't slept properly since Helen's offer."
                  }
                },
                {
                  "phase": "discovery",
                  "type": "multiple_choice",
                  "content": {
                    "instructions": "Fíjate en el diálogo y responde.",
                    "items": [
