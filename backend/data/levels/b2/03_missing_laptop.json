                        "definition": "Almost certainly did",
                        "translation": "seguro que…, debe de haber",
                        "example": "You must have left it there."
                      },
                      {
                        "term": "can't have",
                        "definition": "Almost certainly did not",
                        "translation": "no puede haber…",
                        "example": "I can't have left it in the taxi."
                      },
                      {
                        "term": "should have",
                        "definition": "It was a mistake not to",
                        "translation": "debería haber",
                        "example": "You should have kept it in your bag."
                      },
                      {
                        "term": "could have",
                        "definition": "It was possible but did not happen",
                        "translation": "podría haber",
                        "example": "I could have lost the whole demo."
                      },
