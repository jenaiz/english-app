{
  "level_id": "B2",
  "themes": [
    {
      "theme_id": "opinions_debate",
      "units": [
        {
          "unit_id": "expressing_opinions",
          "title": "Expressing and Defending Opinions",
          "description": "Conectores de contraste para argumentar con matices.",
          "lessons": [
            {
              "lesson_id": "opinion_linkers",
              "title": "Linkers of Contrast",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "dialogue": [
                      {
                        "speaker": "Sara",
                        "text": "Remote work is clearly more productive."
                      },
                      {
                        "speaker": "David",
                        "text": "I see your point. However, many people feel isolated working from home."
                      },
                      {
                        "speaker": "Sara",
                        "text": "That's true, although companies can organise regular meet-ups."
                      },
                      {
                        "speaker": "David",
                        "text": "Despite the meet-ups, junior staff often miss out on learning from colleagues."
                      },
                      {
                        "speaker": "Sara",
                        "text": "Fair enough. In spite of that, I'd still choose a hybrid model."
                      }
                    ]
                  }
                },
                {
                  "phase": "discovery",
                  "type": "multiple_choice",
                  "content": {
                    "instructions": "Analiza los conectores del debate.",
                    "items": [
                      {
                        "question": "What follows 'despite' in the dialogue?",
                        "options": [
                          "A full clause (subject + verb)",
                          "A noun phrase",
                          "A comma"
                        ],
                        "answer": 1,
                        "explanation": "Despite the meet-ups → sustantivo, no oración."
                      },
                      {
                        "question": "What follows 'although'?",
                        "options": [
                          "A full clause",
                          "A noun phrase",
                          "-ing only"
                        ],
                        "answer": 0
                      },
                      {
                        "question": "Where does 'however' usually appear?",
                        "options": [
                          "In the middle of a noun phrase",
                          "At the start of a new sentence, followed by a comma",
                          "Only at the end"
                        ],
                        "answer": 1
                      }
                    ]
                  }
                },
                {
                  "phase": "grammar",
                  "type": "grammar_rule",
                  "content": {
                    "title": "Although / Despite / However",
                    "explanation": "Los tres expresan contraste pero con estructuras distintas. 'Although' + oración; 'despite' / 'in spite of' + sustantivo o -ing (o 'the fact that' + oración); 'however' enlaza dos oraciones y suele ir tras punto o punto y coma, seguido de coma.",
                    "table": {
                      "headers": [
                        "Conector",
                        "Estructura",
                        "Ejemplo"
                      ],
                      "rows": [
                        [
                          "Although",
                          "+ sujeto + verbo",
                          "Although it was raining, we went out."
                        ],
                        [
                          "Despite / In spite of",
                          "+ sustantivo / -ing",
                          "Despite the rain, we went out."
                        ],
                        [
                          "However",
                          ". However, + oración",
                          "It was raining. However, we went out."
                        ]
                      ]
                    },
                    "examples": [
                      "Despite being tired, she finished the report.",
                      "Despite the fact that it was late, they kept working."
                    ]
                  }
                },
                {
                  "phase": "practice",
                  "type": "fill_blanks",
                  "content": {
                    "instructions": "Completa con although, despite o however.",
                    "items": [
                      {
                        "sentence": "___ the traffic, we arrived on time.",
                        "answers": [
                          [
                            "Despite",
                            "In spite of"
                          ]
                        ]
                      },
                      {
                        "sentence": "___ he studied hard, he failed the exam.",
                        "answers": [
                          [
                            "Although",
                            "Even though",
                            "Though"
                          ]
                        ]
                      },
                      {
                        "sentence": "The hotel was expensive. ___, it was worth it.",
                        "answers": [
                          [
                            "However"
                          ]
                        ]
                      },
                      {
                        "sentence": "She went to work ___ feeling ill.",
                        "answers": [
                          [
                            "despite",
                            "in spite of"
                          ]
                        ],
                        "explanation": "Despite + -ing."
                      }
                    ]
                  }
                },
                {
                  "phase": "practice",
                  "type": "transformation",
                  "content": {
                    "instructions": "Reescribe la frase usando el conector indicado.",
                    "items": [
                      {
                        "prompt": "Usa 'despite'",
                        "source": "Although it was cold, we swam in the sea.",
                        "answers": [
                          "Despite the cold, we swam in the sea",
                          "Despite it being cold, we swam in the sea",
                          "Despite the fact that it was cold, we swam in the sea"
                        ]
                      },
                      {
                        "prompt": "Usa 'although'",
                        "source": "Despite her experience, she didn't get the job.",
                        "answers": [
                          "Although she had experience, she didn't get the job",
                          "Although she was experienced, she didn't get the job",
                          "Although she had experience, she did not get the job"
                        ]
                      }
                    ]
                  }
                },
                {
                  "phase": "production",
                  "type": "translation",
                  "content": {
                    "instructions": "Traduce al inglés usando un conector de contraste.",
                    "items": [
                      {
                        "source": "Aunque estaba cansado, terminó el proyecto.",
                        "answers": [
                          "Although he was tired, he finished the project",
                          "Although he was tired he finished the project",
                          "Even though he was tired, he finished the project"
                        ]
                      },
                      {
                        "source": "A pesar de la lluvia, el partido continuó.",
                        "answers": [
                          "Despite the rain, the match continued",
                          "In spite of the rain, the match continued",
                          "Despite the rain, the game continued"
                        ]
                      }
                    ]
                  }
                },
                {
                  "phase": "production",
                  "type": "speaking",
                  "content": {
                    "instructions": "Defiende tu opinión en voz alta.",
                    "items": [
                      {
                        "text": "I see your point. However, I'm not entirely convinced."
                      },
                      {
                        "text": "Despite the advantages, there are some serious risks."
                      }
                    ]
                  }
                },
                {
                  "phase": "vocabulary",
                  "type": "vocabulary_table",
                  "content": {
                    "items": [
                      {
                        "term": "I see your point",
                        "definition": "I understand your argument",
                        "translation": "Entiendo lo que dices",
                        "example": "I see your point, but I disagree."
                      },
                      {
                        "term": "Fair enough",
                        "definition": "That is reasonable",
                        "translation": "Me parece justo",
                        "example": "Fair enough, let's try it your way."
                      },
                      {
                        "term": "Miss out on",
                        "definition": "Lose the chance to experience something",
                        "translation": "Perderse algo",
                        "example": "Don't miss out on this opportunity."
                      },
                      {
                        "term": "Convinced",
                        "definition": "Completely sure",
                        "translation": "Convencido",
                        "example": "I'm not convinced it will work."
                      },
                      {
                        "term": "Drawback",
                        "definition": "A disadvantage",
                        "translation": "Inconveniente",
                        "example": "The main drawback is the cost."
                      }
                    ]
                  }
                },
                {
                  "phase": "review",
                  "type": "speed_quiz",
                  "content": {
                    "instructions": "¡Contrarreloj!",
                    "time_limit_seconds": 40,
                    "items": [
                      {
                        "question": "___ being rich, he isn't happy.",
                        "options": [
                          "Although",
                          "Despite",
                          "However"
                        ],
                        "answer": 1
                      },
                      {
                        "question": "___ it was late, we kept talking.",
                        "options": [
                          "Although",
                          "Despite",
                          "In spite of"
                        ],
                        "answer": 0
                      },
                      {
                        "question": "\"Inconveniente\" =",
                        "options": [
                          "drawback",
                          "fair enough",
                          "point"
                        ],
                        "answer": 0
                      },
                      {
                        "question": "It was cheap. ___, it broke quickly.",
                        "options": [
                          "Despite",
                          "Although",
                          "However"
                        ],
                        "answer": 2
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
