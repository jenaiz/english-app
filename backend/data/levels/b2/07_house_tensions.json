            {
              "lesson_id": "house_tensions_lesson",
              "title": "wish and if only",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "Night shifts",
                    "dialogue": [
                      {
                        "speaker": "Priya",
                        "text": "I wish Ollie wouldn't cook at two in the morning. I could hear the pans from my room."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "I know. And I wish he'd clean up afterwards. The kitchen was a disaster this morning."
                      },
                      {
                        "speaker": "Priya",
                        "text": "To be fair, the food he leaves is amazing."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "True. I wish I could cook like him."
                      },
                      {
                        "speaker": "Ollie",
                        "text": "Morning, both. Is something wrong? You look tired."
                      },
                      {
                        "speaker": "Priya",
                        "text": "Ollie, we need to talk. I wish you'd be a bit quieter at night."
                      },
                      {
                        "speaker": "Ollie",
                        "text": "Oh no. Have I been waking you up? I'm so sorry."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "And the kitchen…"
                      },
                      {
                        "speaker": "Ollie",
                        "text": "I wish I'd known earlier! Why didn't you say something?"
                      },
                      {
                        "speaker": "Priya",
                        "text": "We didn't want to upset you."
                      },
                      {
                        "speaker": "Ollie",
                        "text": "You wouldn't have upset me. From now on, I'll cook quietly and clean everything. Promise."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "But you can still leave us the leftovers."
                      },
                      {
                        "speaker": "Ollie",
                        "text": "Deal. If only all problems were this easy."
                      }
                    ],
                    "passage": "January, year three. Ollie has been working late at the restaurant, and life at Clifton Road has changed."
                  }
                },
