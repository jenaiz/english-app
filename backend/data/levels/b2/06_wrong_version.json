          "unit_id": "wrong_version",
          "title": "The Wrong Version",
          "description": "Lo que habría pasado si…: tercer condicional y wish + past perfect. Además, el past perfect continuous para explicar el porqué: we'd been working until midnight.",
          "lessons": [
            {
              "lesson_id": "wrong_version_lesson",
              "title": "Third conditional and regrets",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "The wrong version",
                    "dialogue": [
                      {
                        "speaker": "Daniel",
                        "text": "I can't believe it. We uploaded the old version."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "If we had checked the files, this wouldn't have happened."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "If I hadn't been so tired last night, I would have noticed."
                      },
                      {
                        "speaker": "Helen",
                        "text": "It's not the end of the world. If Mark had seen it, he would have called us already."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "I wish I had stayed later yesterday."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "And I wish I hadn't uploaded it in such a hurry."
                      },
                      {
                        "speaker": "Helen",
                        "text": "Stop it, both of you. Fix it now, and nobody will know."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Done. The right version is live."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "That was close. If you hadn't spotted it this morning, Helen, we'd have been in real trouble."
                      },
                      {
                        "speaker": "Helen",
                        "text": "Twenty years in this business, Lucía. You learn to check everything twice."
                      },
                      {
                        "speaker": "Mark",
                        "text": "Hi, team! The site looks amazing. Did I miss anything?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Nothing at all, Mark. Everything's fine."
                      }
                    ],
                    "passage": "December. The morning of the launch, Helen opens the new website and sees something strange: it's the old version."
                  }
