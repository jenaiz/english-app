              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "The phone call",
                    "dialogue": [
                      {
                        "speaker": "Helen",
                        "text": "Well? What did he say?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "He admitted that the simple version was better."
                      },
                      {
                        "speaker": "Helen",
                        "text": "Really? That's a first."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "But he insisted on adding a video to every page."
                      },
                      {
                        "speaker": "Helen",
                        "text": "Every page? Did you warn him that it would slow the site down?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Yes, I warned him about it. He refused to listen at first."
                      },
                      {
                        "speaker": "Helen",
                        "text": "Typical. What happened then?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Daniel suggested testing both versions with real guests."
                      },
                      {
                        "speaker": "Helen",
                        "text": "Good idea. Did Mark agree?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Eventually. He promised to send us the results by Friday. And he invited us to go to New York for the launch."
                      },
                      {
                        "speaker": "Helen",
                        "text": "New York! Did he offer to pay for the flights?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "He offered to pay for everything. He even apologised for being so difficult."
                      },
                      {
                        "speaker": "Helen",
                        "text": "Mark Reed apologised? I don't believe it."
                      }
                    ],
                    "passage": "A week later, Mark calls Lucía. Afterwards, she goes to Helen's office to tell her about the conversation."
                  }
                },
