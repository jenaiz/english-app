                  "phase": "vocabulary",
                  "type": "vocabulary_table",
                  "content": {
                    "items": [
                      {
                        "term": "admit",
                        "definition": "Agree that something is true, often unwillingly",
                        "translation": "admitir, reconocer",
                        "example": "He admitted that the simple version was better."
                      },
                      {
                        "term": "insist on",
                        "definition": "Demand something firmly (+ -ing)",
                        "translation": "insistir en",
                        "example": "He insisted on adding a video."
                      },
                      {
                        "term": "warn",
                        "definition": "Tell someone about a danger",
                        "translation": "advertir",
                        "example": "Did you warn him?"
                      },
                      {
                        "term": "refuse",
                        "definition": "Say you will not do something",
                        "translation": "negarse a",
                        "example": "He refused to listen."
                      },
                      {
                        "term": "suggest",
                        "definition": "Give an idea (+ -ing)",
                        "translation": "sugerir",
                        "example": "Daniel suggested testing both versions."
                      },
                      {
                        "term": "promise",
                        "definition": "Say you will certainly do something",
                        "translation": "prometer",
                        "example": "He promised to send the results."
                      },
                      {
                        "term": "invite",
                        "definition": "Ask someone to come",
                        "translation": "invitar",
                        "example": "He invited us to go to New York."
                      },
                      {
                        "term": "offer",
                        "definition": "Say you are willing to do or give something",
                        "translation": "ofrecerse a",
                        "example": "He offered to pay for everything."
                      },
                      {
                        "term": "apologise",
                        "definition": "Say sorry",
                        "translation": "disculparse",
                        "example": "He apologised for being so difficult."
                      },
                      {
                        "term": "slow down",
                        "definition": "Make something slower",
                        "translation": "ralentizar",
                        "example": "It would slow the site down."
                      },
                      {
                        "term": "eventually",
                        "definition": "In the end, after some time",
                        "translation": "al final, finalmente",
                        "example": "Eventually, he agreed."
                      },
                      {
                        "term": "launch",
                        "definition": "The start of a new product or website",
                        "translation": "lanzamiento",
                        "example": "the launch in New York"
                      },
                      {
                        "term": "results",
                        "definition": "What you find out from a test",
                        "translation": "resultados",
                        "example": "the results by Friday"
                      },
                      {
                        "term": "That's a first",
                        "definition": "This has never happened before",
                        "translation": "es la primera vez",
                        "example": "Really? That's a first."
                      }
                    ]
                  }
