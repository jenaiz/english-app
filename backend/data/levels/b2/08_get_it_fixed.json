        {
          "unit_id": "get_it_fixed",
          "title": "The Boiler",
          "description": "Encarga que te hagan cosas: have / get something done. Y la pasiva en todas sus formas: is being repaired, should be fixed.",
          "lessons": [
            {
              "lesson_id": "get_it_fixed_lesson",
              "title": "Causative have and get",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "The boiler",
                    "dialogue": [
                      {
                        "speaker": "Mrs Green",
                        "text": "I'm having the boiler repaired on Thursday. The engineer can't come any earlier."
                      },
                      {
                        "speaker": "Priya",
                        "text": "Thursday? We haven't had hot water since Sunday!"
                      },
                      {
                        "speaker": "Mrs Green",
                        "text": "I know, dear. And while I'm at it, I'm getting the kitchen repainted next month."
                      },
                      {
                        "speaker": "Ollie",
                        "text": "Could you have the oven checked too? It's been making a strange noise."
                      },
                      {
                        "speaker": "Mrs Green",
                        "text": "Fine. I'll get someone to look at it."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Meanwhile, I'm going to shower at the gym. I might get my hair cut while I'm there."
                      },
                      {
                        "speaker": "Priya",
                        "text": "Good plan. I had my car serviced last week, so at least the heating in the car works."
                      },
                      {
                        "speaker": "Mrs Green",
                        "text": "You young people. In my day, we had the chimney swept and lit a fire."
                      },
                      {
                        "speaker": "Ollie",
                        "text": "Shall I make some soup to keep us warm?"
                      },
                      {
                        "speaker": "Mrs Green",
                        "text": "Now that's the best idea I've heard all day."
                      }
                    ],
                    "passage": "February. The boiler at Clifton Road breaks down during the coldest week of the year. Mrs Green comes round."
                  }
                },
                {
                  "phase": "discovery",
                  "type": "multiple_choice",
                  "content": {
                    "instructions": "Fíjate en el diálogo y responde.",
                    "items": [
                      {
