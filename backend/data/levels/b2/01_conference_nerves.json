              "lesson_id": "conference_nerves_lesson",
              "title": "Future continuous and future perfect",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "The night train",
                    "dialogue": [
                      {
                        "speaker": "Daniel",
                        "text": "Will you put that laptop away? You've read those slides about fifty times."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "I can't help it. This time tomorrow, I'll be standing in front of four hundred designers."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "And by eleven o'clock, you'll have finished, and we'll be having a pint to celebrate."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Unless I've forgotten everything by then."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "You won't. What time will we be arriving, anyway?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "The train gets in at six. By the time we check in, it'll be dark."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Grand. I'll have sent the demo to the organisers by then, so that's one less thing to worry about."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Will you be sitting in the front row tomorrow?"
                      },
                      {
                        "speaker": "Daniel",
                        "text": "I'll be sitting at the back, controlling the screen. If anything goes wrong, I'll be there."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Thank you. I'd be lost without you, you know."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "I know. Now, are you going to eat something, or are you too nervous?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Too nervous. But I'll be starving by the time we get there."
                      }
                    ],
                    "passage": "October, year two. Lucía and Daniel are on the train to Edinburgh. Her talk at the European Design Forum is tomorrow morning, and she hasn't stopped checking her slides since they left Bristol."
                  }
                },
                {
                  "phase": "discovery",
                  "type": "multiple_choice",
                  "content": {
                    "instructions": "Fíjate en el diálogo y responde.",
                    "items": [
                      {
                        "question": "\"This time tomorrow, I'll be standing in front of four hundred designers.\" This describes…",
