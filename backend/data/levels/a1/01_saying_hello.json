      "theme_id": "hello_bristol",
      "units": [
        {
          "unit_id": "saying_hello",
          "title": "Hello, Bristol",
          "description": "Lucía llega a Bristol. Preséntate y di de dónde eres con el verbo to be (I, you, we).",
          "lessons": [
            {
              "lesson_id": "hello_basics",
              "title": "To be: I'm Lucía",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "Hello, Bristol",
                    "dialogue": [
                      {
                        "speaker": "Mrs Green",
                        "text": "Hello! Are you Lucía?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Yes, I am. Hello!"
                      },
                      {
                        "speaker": "Mrs Green",
                        "text": "I'm Mrs Green. Welcome to Bristol!"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Thank you. Nice to meet you."
                      },
                      {
                        "speaker": "Mrs Green",
                        "text": "Nice to meet you too. Where are you from, Lucía?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "I'm from Spain. I'm from Valencia."
                      },
                      {
                        "speaker": "Mrs Green",
                        "text": "Oh, lovely! Are you tired?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Yes, I am. I'm very tired!"
                      },
                      {
                        "speaker": "Mrs Green",
                        "text": "Come in, come in. We're all friends here. Here's your key."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Thank you, Mrs Green!"
                      }
                    ],
                    "passage": "It's Saturday evening. This is Clifton Road, in Bristol. Lucía is at number fourteen with a big suitcase. She's from Spain and she's very tired."
                  }
                },
                {
                  "phase": "discovery",
                  "type": "multiple_choice",
                  "content": {
                    "tag": "to_be",
                    "instructions": "Fíjate en el diálogo y responde.",
                    "items": [
                      {
                        "question": "In \"I'm Lucía\", what does 'm mean?",
                        "options": [
                          "am",
                          "is",
                          "are"
                        ],
                        "answer": 0,
                        "explanation": "I'm = I am. La contracción es lo normal al hablar."
                      },
                      {
                        "question": "Mrs Green says \"We're all friends here.\" We're = …",
                        "options": [
                          "We is",
                          "We are",
                          "We am"
                        ],
                        "answer": 1,
                        "explanation": "We're = we are."
                      },
                      {
                        "question": "\"Where are you from?\" What does Lucía answer?",
                        "options": [
                          "I'm from Spain.",
                          "I from Spain.",
                          "I'm Spain from."
                        ],
                        "answer": 0,
                        "explanation": "En inglés el sujeto y el verbo siempre aparecen: I + am."
                      },
                      {
                        "question": "\"Are you tired?\" Which short answer is correct?",
                        "options": [
                          "Yes, I'm.",
                          "Yes, I am.",
                          "Yes, I are."
                        ],
                        "answer": 1,
                        "explanation": "En las respuestas cortas afirmativas no se contrae: Yes, I am."
                      }
                    ]
                  }
                },
                {
                  "phase": "grammar",
                  "type": "grammar_rule",
                  "content": {
                    "tag": "to_be",
                    "title": "The verb 'to be': I, you, we",
                    "explanation": "To be significa ser o estar. En inglés siempre hay que poner el sujeto: no se dice «Am from Spain», sino «I'm from Spain».\n\nAl hablar usamos casi siempre contracciones (I'm, you're, we're). En las respuestas cortas afirmativas no se contrae: «Are you tired? — Yes, I am» (nunca «Yes, I'm»).\n\nPara preguntar, el verbo va delante del sujeto: «Are you Lucía?». Con it (para cosas, el día o la hora) la forma es is: «It's Saturday».",
                    "table": {
                      "headers": [
                        "Sujeto",
                        "Forma completa",
                        "Contracción",
                        "Negativa",
                        "Pregunta"
                      ],
                      "rows": [
                        [
                          "I",
                          "I am",
                          "I'm",
                          "I'm not",
                          "Am I…?"
                        ],
                        [
                          "you",
                          "you are",
                          "you're",
                          "you aren't",
                          "Are you…?"
                        ],
                        [
                          "we",
                          "we are",
                          "we're",
                          "we aren't",
                          "Are we…?"
                        ],
                        [
                          "it",
                          "it is",
                          "it's",
                          "it isn't",
                          "Is it…?"
                        ]
                      ]
                    },
                    "examples": [
                      "I'm Lucía. I'm from Spain.",
                      "Are you Lucía? — Yes, I am.",
                      "We're all friends here.",
                      "I'm not English. I'm Spanish."
                    ]
                  }
                },
