                            "is not"
                          ]
                        ]
                      },
                      {
                        "sentence": "___ Javi a student? — Yes, he is.",
                        "answers": [
                          [
                            "Is"
                          ]
                        ]
                      },
                      {
                        "sentence": "Priya's parents are in Leicester. ___ house is big.",
                        "answers": [
                          [
                            "Their"
                          ]
                        ]
                      },
                      {
                        "sentence": "Sam is a musician. ___ band is great.",
                        "answers": [
                          [
                            "His"
                          ]
                        ]
                      },
                      {
                        "sentence": "Priya is a nurse. ___ hospital is in Bristol.",
                        "answers": [
                          [
                            "Her"
                          ]
                        ]
                      },
                      {
                        "sentence": "My parents ___ in Spain. They aren't in Bristol.",
                        "answers": [
                          [
                            "are"
                          ]
                        ]
                      }
                    ]
                  }
                },
                {
                  "phase": "practice",
                  "type": "word_order",
                  "content": {
                    "instructions": "Ordena las palabras.",
                    "items": [
                      {
                        "answer": "She is a nurse"
