      "units": [
        {
          "unit_id": "new_flatmates",
          "title": "The Flatmates",
          "description": "Conoce a Sam y Priya: to be con he, she y they, y los posesivos.",
          "lessons": [
            {
              "lesson_id": "flatmates_lesson",
              "title": "To be: he, she, they + possessives",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "The flatmates",
                    "dialogue": [
                      {
                        "speaker": "Sam",
                        "text": "Hiya! You're Lucía, right? I'm Sam."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Hi, Sam. Nice to meet you."
                      },
                      {
                        "speaker": "Sam",
                        "text": "And this is Priya. She's a nurse."
                      },
                      {
                        "speaker": "Priya",
                        "text": "Hello, Lucía. Welcome to the house!"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Thanks! Are you a nurse too, Sam?"
                      },
                      {
                        "speaker": "Sam",
                        "text": "No, I'm not. I'm a musician. And a waiter!"
                      },
                      {
                        "speaker": "Priya",
                        "text": "His band is really good. They're called The Clifton Cats."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Cool! Is your family in Bristol, Priya?"
                      },
                      {
                        "speaker": "Priya",
                        "text": "No, they aren't. My parents are in Leicester. Is your family in Spain?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Yes, they are. My parents are in Valencia, and my brother, Javi."
                      },
                      {
                        "speaker": "Sam",
                        "text": "Is he a student?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Yes, he is. He's twenty-five, and he's very funny."
                      }
                    ],
                    "passage": "Lucía is in the kitchen. A man and a woman are at the table. They're her new flatmates."
                  }
                },
                {
                  "phase": "discovery",
                  "type": "multiple_choice",
                  "content": {
                    "instructions": "Fíjate en el diálogo y responde.",
                    "items": [
                      {
                        "question": "\"She's a nurse.\" She's = …",
                        "options": [
                          "She is",
                          "She has",
                          "She are"
                        ],
                        "answer": 0,
                        "explanation": "Aquí 's = is."
                      },
                      {
                        "question": "\"Is he a student?\" — \"Yes, he ___.\"",
                        "options": [
                          "is",
                          "are",
                          "he's"
                        ],
                        "answer": 0,
                        "explanation": "Respuesta corta: Yes, he is."
                      },
                      {
                        "question": "\"His band is really good.\" Whose band?",
                        "options": [
                          "Sam's",
                          "Priya's",
                          "Lucía's"
                        ],
                        "answer": 0,
                        "explanation": "His = de él (Sam)."
                      },
                      {
                        "question": "Who says \"My parents are in Leicester\"?",
                        "options": [
                          "Lucía",
                          "Priya",
                          "Sam"
                        ],
                        "answer": 1
                      }
                    ]
                  }
                },
                {
                  "phase": "grammar",
                  "type": "grammar_rule",
                  "content": {
                    "title": "To be: he, she, it, they + possessive adjectives",
                    "explanation": "Con he (él), she (ella) e it (cosa o animal) el verbo es is. Con they (ellos/ellas) es are.\n\nNegativa: isn't / aren't. Pregunta: el verbo va delante: «Is he a student? — Yes, he is / No, he isn't».\n\nLos posesivos van antes del nombre y no cambian en plural: my parents, his band, her family. Ojo: his = de él; her = de ella.",
                    "table": {
                      "headers": [
                        "Sujeto",
                        "Afirmativa",
                        "Negativa",
                        "Pregunta",
                        "Posesivo"
                      ],
                      "rows": [
                        [
                          "I",
                          "I'm",
                          "I'm not",
                          "Am I…?",
                          "my"
                        ],
                        [
                          "you",
                          "you're",
                          "you aren't",
                          "Are you…?",
                          "your"
                        ],
                        [
                          "he",
                          "he's",
                          "he isn't",
                          "Is he…?",
                          "his"
                        ],
                        [
                          "she",
                          "she's",
                          "she isn't",
                          "Is she…?",
                          "her"
                        ],
                        [
                          "it",
                          "it's",
                          "it isn't",
                          "Is it…?",
                          "its"
                        ],
                        [
                          "we",
                          "we're",
                          "we aren't",
                          "Are we…?",
                          "our"
                        ],
                        [
                          "they",
                          "they're",
                          "they aren't",
                          "Are they…?",
                          "their"
                        ]
                      ]
                    },
                    "examples": [
                      "Priya is a nurse. She isn't a doctor.",
                      "Sam is a musician. His band is The Clifton Cats.",
                      "Lucía's parents are in Valencia. Their house is near the sea.",
                      "Is Javi a student? — Yes, he is."
                    ]
                  }
                },
                {
                  "phase": "practice",
                  "type": "fill_blanks",
                  "content": {
                    "instructions": "Completa con is, are, isn't o un posesivo (his, her, their).",
                    "items": [
                      {
                        "sentence": "Priya ___ a nurse.",
