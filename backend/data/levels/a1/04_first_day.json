          "unit_id": "first_day",
          "title": "The First Day",
          "description": "Primer día en Harbour Studio: preguntas con Wh-, la hora y have got. Y las preposiciones de tiempo in, on, at.",
          "lessons": [
            {
              "lesson_id": "first_day_lesson",
              "title": "Wh- questions and the time",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "The first day",
                    "dialogue": [
                      {
                        "speaker": "Helen",
                        "text": "Good morning! You're Lucía Martín, right? I'm Helen Carter."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Good morning, Helen. Nice to meet you."
                      },
                      {
                        "speaker": "Helen",
                        "text": "And this is Daniel. He's a developer. He's from Ireland."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Hi, Lucía! How are you?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "I'm fine, thanks. Where in Ireland are you from?"
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Galway. It's a grand place on the west coast."
                      },
                      {
                        "speaker": "Helen",
                        "text": "Have you got your laptop, Lucía?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Yes, I have. What's my desk number?"
                      },
                      {
                        "speaker": "Daniel",
                        "text": "It's fourteen. It's next to my desk."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Fourteen? My house number is fourteen too!"
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Ha! That's lucky. What time is the meeting, Helen?"
                      },
                      {
                        "speaker": "Helen",
                        "text": "It's at half past nine. And lunch is at one o'clock."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "And Friday is pizza day!"
                      }
                    ],
                    "passage": "It's Monday morning. It's half past eight. This is Harbour Studio, an office near the harbour. Lucía is the new designer."
                  }
