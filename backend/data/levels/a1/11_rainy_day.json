          "unit_id": "rainy_day",
          "title": "A Rainy Saturday",
          "description": "Describe lo que pasa ahora mismo con el present continuous; ropa y tiempo. Y planes con be going to.",
          "lessons": [
            {
              "lesson_id": "rainy_day_lesson",
              "title": "Present continuous",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "A rainy Saturday",
                    "dialogue": [
                      {
                        "speaker": "Javi",
                        "text": "Hi, Lucía! What are you doing?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "I'm looking at the rain! It's raining again."
                      },
                      {
                        "speaker": "Javi",
                        "text": "It's sunny here. I'm wearing shorts and a T-shirt!"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Lucky you! I'm wearing a jumper, jeans and thick socks."
                      },
                      {
                        "speaker": "Javi",
                        "text": "Where are Sam and Priya?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Priya is working today. And Sam is sleeping, of course. He always sleeps on Saturday mornings."
                      },
                      {
                        "speaker": "Javi",
                        "text": "And Daniel? The Irish guy?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Javi! I don't know. He usually goes running on Saturdays… in the rain!"
                      },
                      {
                        "speaker": "Javi",
                        "text": "Are you smiling, Lucía?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "No, I'm not! Oh, wait. Sam is coming into the kitchen. He's carrying his guitar."
                      },
                      {
                        "speaker": "Sam",
                        "text": "Morning! Who are you talking to?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "My brother. Say hello!"
                      },
                      {
                        "speaker": "Sam",
                        "text": "Hiya, Javi! Bring the sun to Bristol, please!"
                      }
                    ],
                    "passage": "It's Saturday morning and it's raining. It's cold and grey. Lucía is in the kitchen with a coffee. Javi is on the phone."
                  }
                },
                {
                  "phase": "discovery",
                  "type": "multiple_choice",
                  "content": {
