          "unit_id": "in_the_park",
          "title": "Football in the Park",
          "description": "Habla de habilidades y pide permiso con can / can't. Además, could / couldn't y very / really.",
          "lessons": [
            {
              "lesson_id": "in_the_park_lesson",
              "title": "can / can't",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "Football in the park",
                    "dialogue": [
                      {
                        "speaker": "Daniel",
                        "text": "Can you play football, Lucía?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Yes, I can! I can't run very fast, but I can play."
                      },
                      {
                        "speaker": "Helen",
                        "text": "Lucía, you're on my team. Daniel, you're on Sam's team."
                      },
                      {
                        "speaker": "Sam",
                        "text": "Can I be the goalkeeper? I can't kick the ball very well!"
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Of course you can."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Goal!"
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Wow! You can play really well."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "I play every week in Valencia with my friends."
                      },
                      {
                        "speaker": "Sam",
                        "text": "Helen, can we stop now? I can't breathe!"
                      },
                      {
                        "speaker": "Helen",
                        "text": "Ha! OK, five minutes. Who can bring some water?"
                      },
                      {
                        "speaker": "Daniel",
                        "text": "I can. Lucía, can you help me?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Yes, of course."
                      }
                    ],
                    "passage": "Sunday afternoon in Brandon Hill park. People from Harbour Studio play football here every month. Today Sam is with them too."
                  }
                },
                {
                  "phase": "discovery",
                  "type": "multiple_choice",
