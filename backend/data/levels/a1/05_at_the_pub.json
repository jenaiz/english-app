          "title": "Dinner at The Old Duke",
          "description": "Pide comida y bebida en un pub con there is/are, some/any y Can I have…? Además, how much / how many y I'd like.",
          "lessons": [
            {
              "lesson_id": "pub_lesson",
              "title": "There is / there are, some / any",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "Dinner at The Old Duke",
                    "dialogue": [
                      {
                        "speaker": "Waiter",
                        "text": "Hi there! What can I get you?"
                      },
                      {
                        "speaker": "Priya",
                        "text": "Can I have a lemonade, please?"
                      },
                      {
                        "speaker": "Sam",
                        "text": "A cider for me, please."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Is there any wine?"
                      },
                      {
                        "speaker": "Waiter",
                        "text": "Yes, there is. There's red wine and white wine."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "A glass of red wine, please."
                      },
                      {
                        "speaker": "Sam",
                        "text": "Are there any vegetarian dishes? Priya's vegetarian."
                      },
                      {
                        "speaker": "Waiter",
                        "text": "Yes, there are some. There's a vegetable curry, and there are some great veggie burgers."
                      },
                      {
                        "speaker": "Priya",
                        "text": "The curry, please."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "And can I have fish and chips?"
                      },
                      {
                        "speaker": "Waiter",
                        "text": "Of course. Anything else?"
                      },
                      {
                        "speaker": "Sam",
                        "text": "Some bread for the table, please!"
                      },
                      {
                        "speaker": "Waiter",
                        "text": "Lovely. That's thirty-two pounds fifty, please."
                      }
                    ],
                    "passage": "It's Friday evening. Lucía, Sam and Priya are at The Old Duke, a pub near the harbour. It's busy and there's music."
                  }
