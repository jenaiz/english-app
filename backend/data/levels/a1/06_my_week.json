              "lesson_id": "my_week_lesson",
              "title": "Present simple: I, you, we, they",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "Video call with Javi",
                    "dialogue": [
                      {
                        "speaker": "Javi",
                        "text": "¡Hola, Lucía!"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "No, Javi. English only, remember?"
                      },
                      {
                        "speaker": "Javi",
                        "text": "OK, OK! Hello! How's your new job?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "I love it. I get up at seven and I go to work by bus."
                      },
                      {
                        "speaker": "Javi",
                        "text": "By bus? You don't walk?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "No, I don't. The office is far. I start at nine and I finish at half past five."
                      },
                      {
                        "speaker": "Javi",
                        "text": "And your flatmates? Do you eat together?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Yes, we do. We have dinner together on Fridays."
                      },
                      {
                        "speaker": "Javi",
                        "text": "What do you do in the evenings?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "I study English and I watch TV with Sam and Priya. And you?"
                      },
                      {
                        "speaker": "Javi",
                        "text": "I don't study. I play video games!"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Javi! Your exam is in December!"
                      },
                      {
                        "speaker": "Javi",
                        "text": "I know, I know…"
                      }
                    ],
                    "passage": "Sunday evening. Lucía is in her room. Her brother Javi is on a video call from Valencia. He's a student, and his English exam is in December."
                  }
