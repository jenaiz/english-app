{
  "level_id": "B1",
  "title": "B1 Intermediate",
  "description": "Nivel intermedio de consolidación y fluidez",
  "themes": [
    {
      "theme_id": "travel_accommodation",
      "title": "Travel & Accommodations",
      "units": [
        {
          "unit_id": "hotel_checkin",
          "title": "Checking into a Hotel & Complaints",
          "description": "Aprende phrasal verbs y vocabulario para gestionar tu estancia.",
          "lessons": [
            {
              "lesson_id": "phrasal_verbs_hotel",
              "title": "Phrasal Verbs for Hotel Stay",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "dialogue": [
                      {"speaker": "Receptionist", "text": "Good afternoon, how can I help you?"},
                      {"speaker": "Guest", "text": "Hi, I'd like to check in, please. I booked a double room."},
                      {"speaker": "Receptionist", "text": "Of course. Could you fill in this form? Breakfast is from seven to ten."},
                      {"speaker": "Guest", "text": "Great. And what time do we need to check out?"},
                      {"speaker": "Receptionist", "text": "Check-out is at noon. Please turn off the air conditioning when you go out."},
                      {"speaker": "Guest", "text": "Sure. Can you pick us up from the station tomorrow?"},
                      {"speaker": "Receptionist", "text": "Yes, we can pick you up at nine. Enjoy your stay!"}
                    ]
                  }
                },
                {
                  "phase": "discovery",
                  "type": "match_pairs",
                  "content": {
                    "instructions": "Empareja cada phrasal verb del diálogo con su significado.",
                    "pairs": [
                      {"left": "Check in", "right": "Registrarse"},
                      {"left": "Check out", "right": "Dejar la habitación"},
                      {"left": "Fill in", "right": "Rellenar"},
                      {"left": "Turn off", "right": "Apagar"},
                      {"left": "Pick up", "right": "Recoger"}
                    ]
                  }
                },
                {
                  "phase": "discovery",
                  "type": "multiple_choice",
                  "content": {
                    "instructions": "Fíjate en dónde va el objeto.",
                    "items": [
                      {"question": "\"We can pick ___ up at nine.\" The receptionist said…", "options": ["you", "up you", "your"], "answer": 0, "explanation": "Con pronombre, el objeto va en medio: pick you up."},
                      {"question": "Which sentence is correct?", "options": ["I'd like to check the hotel in", "I'd like to check in the hotel", "I'd like to check in"], "answer": 2}
                    ]
                  }
                },
                {
                  "phase": "grammar",
                  "type": "grammar_rule",
                  "content": {
                    "title": "Phrasal Verbs: Separables vs Inseparables",
                    "explanation": "Algunos phrasal verbs no llevan objeto (check in, go out). Los separables (turn off, fill in, pick up) permiten poner el objeto en medio o al final, PERO si el objeto es un pronombre (it, them, you…) tiene que ir en medio.",
                    "table": {
                      "headers": ["Objeto", "Posición", "Ejemplo"],
                      "rows": [
                        ["Sustantivo", "En medio o al final", "Turn off the light / Turn the light off"],
                        ["Pronombre", "Solo en medio", "Turn it off (✗ Turn off it)"],
                        ["Sin objeto", "—", "We checked in at 3 PM."]
                      ]
                    },
                    "examples": ["Could you fill in this form? / Could you fill this form in?", "Can you fill it in, please?", "We'll pick them up at nine."]
                  }
                },
                {
                  "phase": "practice",
                  "type": "fill_blanks",
                  "content": {
                    "instructions": "Completa con la partícula correcta (in, out, off, up).",
                    "items": [
                      {"sentence": "We have to check ___ by noon.", "answers": [["out"]]},
                      {"sentence": "Please fill ___ your passport number.", "answers": [["in"]]},
                      {"sentence": "Don't forget to turn the lights ___.", "answers": [["off"]]},
                      {"sentence": "The taxi will pick us ___ at nine.", "answers": [["up"]]}
                    ]
                  }
                },
                {
                  "phase": "practice",
                  "type": "transformation",
                  "content": {
                    "instructions": "Sustituye el objeto por un pronombre (it / them).",
                    "items": [
                      {"prompt": "the TV → it", "source": "Turn off the TV.", "answers": ["Turn it off"], "explanation": "Pronombre siempre en medio: turn it off."},
                      {"prompt": "the form → it", "source": "Fill in the form.", "answers": ["Fill it in"]},
                      {"prompt": "the guests → them", "source": "Pick up the guests.", "answers": ["Pick them up"]}
                    ]
                  }
                },
                {
                  "phase": "practice",
                  "type": "word_order",
                  "content": {
                    "instructions": "Ordena la frase.",
                    "items": [
                      {"answer": "Could you turn it off?", "distractors": ["on"]},
                      {"answer": "We checked in at three"}
                    ]
                  }
                },
                {
                  "phase": "production",
                  "type": "translation",
                  "content": {
                    "instructions": "Traduce al inglés.",
                    "items": [
                      {"source": "¿Puedes rellenarlo?", "answers": ["Can you fill it in?", "Could you fill it in?", "Can you fill it out?", "Could you fill it out?"]},
                      {"source": "Nos registramos a las tres.", "answers": ["We checked in at three", "We checked in at 3", "We check in at three"]}
                    ]
                  }
                },
                {
                  "phase": "production",
                  "type": "speaking",
                  "content": {
                    "instructions": "Lee en voz alta como si estuvieras en recepción.",
                    "items": [
                      {"text": "Hi, I'd like to check in, please."},
                      {"text": "What time do we need to check out?"}
                    ]
                  }
                },
                {
                  "phase": "vocabulary",
                  "type": "vocabulary_table",
                  "content": {
                    "items": [
                      {"term": "Check in", "definition": "Arrive and register at a hotel", "translation": "Registrarse", "example": "We checked in at 3 PM."},
                      {"term": "Check out", "definition": "Pay and leave a hotel", "translation": "Dejar la habitación", "example": "We have to check out by noon."},
                      {"term": "Fill in", "definition": "Complete a form with information", "translation": "Rellenar", "example": "Please fill in your passport number."},
                      {"term": "Turn off", "definition": "Stop a device working", "translation": "Apagar", "example": "Turn off the air conditioning when you leave."},
                      {"term": "Pick up", "definition": "Collect someone by car", "translation": "Recoger", "example": "We'll pick you up at nine."}
                    ]
                  }
                },
                {
                  "phase": "review",
                  "type": "speed_quiz",
                  "content": {
                    "instructions": "¡Contrarreloj!",
                    "time_limit_seconds": 40,
                    "items": [
                      {"question": "Correct:", "options": ["Turn off it", "Turn it off", "Turn it of"], "answer": 1},
                      {"question": "\"Rellenar un formulario\" =", "options": ["fill in a form", "fill up a form", "check in a form"], "answer": 0},
                      {"question": "We need to ___ by 12.", "options": ["check out", "check off", "check up"], "answer": 0},
                      {"question": "\"Recoger a alguien\" =", "options": ["pick up", "turn up", "fill up"], "answer": 0}
                    ]
                  }
                }
              ]
            },
            {
              "lesson_id": "hotel_complaints",
              "title": "Making a Polite Complaint",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "dialogue": [
                      {"speaker": "Guest", "text": "Excuse me, I'm afraid there's a problem with my room."},
                      {"speaker": "Receptionist", "text": "I'm sorry to hear that. What seems to be the problem?"},
                      {"speaker": "Guest", "text": "The heating isn't working and the room is freezing. Would it be possible to change rooms?"},
                      {"speaker": "Receptionist", "text": "I apologise. I'll send someone up right away, or we can move you to another room."},
                      {"speaker": "Guest", "text": "I was wondering if you could also give us a discount for tonight."}
                    ]
                  }
                },
                {
                  "phase": "discovery",
                  "type": "multiple_choice",
                  "content": {
                    "instructions": "¿Cómo suaviza el cliente sus quejas?",
                    "items": [
                      {"question": "Which phrase does the guest use to introduce the problem politely?", "options": ["I'm afraid…", "You must…", "Listen!"], "answer": 0},
                      {"question": "\"Would it be possible to change rooms?\" is…", "options": ["An order", "A polite request", "A threat"], "answer": 1},
                      {"question": "After \"I was wondering if you could…\" comes…", "options": ["the infinitive without 'to'", "the -ing form", "a past participle"], "answer": 0, "explanation": "could + infinitivo sin 'to': could give, could send…"}
                    ]
                  }
                },
                {
                  "phase": "grammar",
                  "type": "grammar_rule",
                  "content": {
                    "title": "Softening Complaints",
                    "explanation": "En inglés las quejas suenan mucho más educadas si se suavizan. Usamos fórmulas indirectas que preceden a la petición.",
                    "table": {
                      "headers": ["Directo (brusco)", "Suavizado (educado)"],
                      "rows": [
                        ["The shower doesn't work.", "I'm afraid the shower doesn't work."],
                        ["Change my room.", "Would it be possible to change rooms?"],
                        ["Give me more towels.", "I was wondering if you could send up some towels."],
                        ["Turn the music down.", "Would you mind turning the music down?"]
                      ]
                    },
                    "examples": ["I'm afraid there's a problem with the bill.", "Would you mind checking it again?"]
                  }
                },
                {
                  "phase": "practice",
                  "type": "fill_blanks",
                  "content": {
                    "instructions": "Completa la fórmula educada.",
                    "items": [
                      {"sentence": "I'm ___ the Wi-Fi isn't working.", "answers": [["afraid"]]},
                      {"sentence": "Would it be ___ to have a late check-out?", "answers": [["possible"]]},
                      {"sentence": "Would you mind ___ (turn) the music down?", "answers": [["turning"]], "explanation": "Would you mind + -ing."},
                      {"sentence": "I was ___ if you could help me.", "answers": [["wondering"]]}
                    ]
                  }
                },
                {
                  "phase": "practice",
                  "type": "transformation",
                  "content": {
                    "instructions": "Convierte la queja directa en una educada.",
                    "items": [
                      {"prompt": "Usa 'Would it be possible to…?'", "source": "Change my room.", "answers": ["Would it be possible to change my room?", "Would it be possible to change rooms?"]},
                      {"prompt": "Usa 'Would you mind…?'", "source": "Close the window.", "answers": ["Would you mind closing the window?"]}
                    ]
                  }
                },
                {
                  "phase": "production",
                  "type": "speaking",
                  "content": {
                    "instructions": "Haz la queja en voz alta, con educación.",
                    "items": [
                      {"text": "I'm afraid there's a problem with my room."},
                      {"text": "Would it be possible to change rooms?"}
                    ]
                  }
                },
                {
                  "phase": "production",
                  "type": "dictation",
                  "content": {
                    "instructions": "Escucha y escribe.",
                    "items": [{"text": "I was wondering if you could send up some extra towels."}]
                  }
                },
                {
                  "phase": "vocabulary",
                  "type": "vocabulary_table",
                  "content": {
                    "items": [
                      {"term": "Complaint", "definition": "A statement that something is wrong", "translation": "Queja", "example": "I'd like to make a complaint."},
                      {"term": "Refund", "definition": "Money returned to you", "translation": "Reembolso", "example": "Can I get a refund for the first night?"},
                      {"term": "Noisy", "definition": "Making a lot of noise", "translation": "Ruidoso", "example": "The room next door is very noisy."},
                      {"term": "Freezing", "definition": "Extremely cold", "translation": "Helado", "example": "The room is freezing."},
                      {"term": "Discount", "definition": "A reduction in price", "translation": "Descuento", "example": "Could you give us a discount?"}
                    ]
                  }
                },
                {
                  "phase": "review",
                  "type": "speed_quiz",
                  "content": {
                    "instructions": "¡Contrarreloj!",
                    "time_limit_seconds": 35,
                    "items": [
                      {"question": "Would you mind ___ the door?", "options": ["close", "closing", "to close"], "answer": 1},
                      {"question": "\"Reembolso\" =", "options": ["refund", "discount", "receipt"], "answer": 0},
                      {"question": "Most polite:", "options": ["Fix the heating.", "I'm afraid the heating isn't working.", "The heating is broken!"], "answer": 1}
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "unit_id": "airport_travel",
          "title": "At the Airport",
          "description": "Vocabulario y expresiones para facturar, embarcar y resolver imprevistos.",
          "lessons": [
            {
              "lesson_id": "airport_checkin",
              "title": "Check-in and Boarding",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "dialogue": [
                      {"speaker": "Agent", "text": "Can I see your passport and boarding pass, please?"},
                      {"speaker": "Passenger", "text": "Here you are. I'd like to drop off this suitcase."},
                      {"speaker": "Agent", "text": "Your flight has been delayed by forty minutes. Boarding starts at gate 12."},
                      {"speaker": "Passenger", "text": "Has the gate been announced yet?"},
                      {"speaker": "Agent", "text": "Yes, it has. The plane will take off at nine fifteen."}
                    ]
                  }
                },
                {
                  "phase": "discovery",
                  "type": "match_pairs",
                  "content": {
                    "instructions": "Empareja cada término con su traducción.",
                    "pairs": [
                      {"left": "Boarding pass", "right": "Tarjeta de embarque"},
                      {"left": "Delayed", "right": "Retrasado"},
                      {"left": "Take off", "right": "Despegar"},
                      {"left": "Gate", "right": "Puerta de embarque"}
                    ]
                  }
                },
                {
                  "phase": "grammar",
                  "type": "grammar_rule",
                  "content": {
                    "title": "Passive voice in announcements",
                    "explanation": "En aeropuertos se usa mucho la voz pasiva porque importa lo que pasa, no quién lo hace. Se forma con 'to be' + participio.",
                    "table": {
                      "headers": ["Tiempo", "Pasiva", "Ejemplo"],
                      "rows": [
                        ["Present simple", "is / are + participio", "Passengers are asked to go to gate 12."],
                        ["Present perfect", "has / have been + participio", "Your flight has been delayed."],
                        ["Past simple", "was / were + participio", "The flight was cancelled."]
                      ]
                    },
                    "examples": ["Bags are checked at desk 4.", "The gate has been changed."]
                  }
                },
                {
                  "phase": "practice",
                  "type": "fill_blanks",
                  "content": {
                    "instructions": "Completa con la pasiva correcta.",
                    "items": [
                      {"sentence": "Your flight has ___ delayed.", "answers": [["been"]]},
                      {"sentence": "Passengers ___ asked to switch off their phones.", "answers": [["are"]]},
                      {"sentence": "Yesterday the flight ___ cancelled.", "answers": [["was"]]}
                    ]
                  }
                },
                {
                  "phase": "practice",
                  "type": "word_order",
                  "content": {
                    "instructions": "Ordena el anuncio.",
                    "items": [
                      {"answer": "The gate has been changed"},
                      {"answer": "Your flight has been delayed by forty minutes"}
                    ]
                  }
                },
                {
                  "phase": "production",
                  "type": "dictation",
                  "content": {
                    "instructions": "Escucha el anuncio y escríbelo.",
                    "items": [
                      {"text": "Flight BA246 has been delayed."},
                      {"text": "Passengers are asked to go to gate twelve."}
                    ]
                  }
                },
                {
                  "phase": "production",
                  "type": "translation",
                  "content": {
                    "instructions": "Traduce al inglés.",
                    "items": [
                      {"source": "Mi vuelo ha sido cancelado.", "answers": ["My flight has been cancelled", "My flight has been canceled"]}
                    ]
                  }
                },
                {
                  "phase": "vocabulary",
                  "type": "vocabulary_table",
                  "content": {
                    "items": [
                      {"term": "Boarding pass", "definition": "Document that lets you get on a plane", "translation": "Tarjeta de embarque", "example": "Have your boarding pass ready."},
                      {"term": "Delayed", "definition": "Later than planned", "translation": "Retrasado", "example": "Our flight was delayed."},
                      {"term": "Take off", "definition": "When a plane leaves the ground", "translation": "Despegar", "example": "The plane takes off at 9 PM."},
                      {"term": "Drop off", "definition": "Leave something somewhere", "translation": "Dejar / facturar", "example": "I need to drop off my suitcase."},
                      {"term": "Gate", "definition": "Where you board the plane", "translation": "Puerta de embarque", "example": "Go to gate 12."}
                    ]
                  }
                },
                {
                  "phase": "review",
                  "type": "speed_quiz",
                  "content": {
                    "instructions": "¡Contrarreloj!",
                    "time_limit_seconds": 35,
                    "items": [
                      {"question": "The flight has ___ cancelled.", "options": ["be", "been", "being"], "answer": 1},
                      {"question": "\"Despegar\" =", "options": ["take off", "drop off", "turn off"], "answer": 0},
                      {"question": "Bags ___ checked at desk 4.", "options": ["is", "are", "be"], "answer": 1}
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "theme_id": "work_life",
      "title": "Work & Professional Life",
      "units": [
        {
          "unit_id": "job_interview",
          "title": "Job Interviews",
          "description": "Habla de tu experiencia usando present perfect y past simple.",
          "lessons": [
            {
              "lesson_id": "interview_experience",
              "title": "Talking About Experience",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "dialogue": [
                      {"speaker": "Interviewer", "text": "Tell me about your experience."},
                      {"speaker": "Candidate", "text": "I've worked in customer service for five years. In my last job, I managed a team of six."},
                      {"speaker": "Interviewer", "text": "Have you ever worked abroad?"},
                      {"speaker": "Candidate", "text": "Yes, I have. I worked in Dublin in 2019 for about a year."},
                      {"speaker": "Interviewer", "text": "And have you led any projects recently?"},
                      {"speaker": "Candidate", "text": "I've just finished a project to improve our customer response times."}
                    ]
                  }
                },
                {
                  "phase": "discovery",
                  "type": "multiple_choice",
                  "content": {
                    "instructions": "Fíjate en los tiempos verbales del candidato.",
                    "items": [
                      {"question": "\"I worked in Dublin in 2019.\" Why past simple?", "options": ["It's a finished action at a specific time", "It's still happening", "It's a future plan"], "answer": 0},
                      {"question": "\"I've worked in customer service for five years.\" Does the candidate still work there?", "options": ["Yes, probably", "No, definitely not", "We can't know"], "answer": 0, "explanation": "Present perfect + for → la acción continúa hasta hoy."},
                      {"question": "Which question did the interviewer use for life experience?", "options": ["Did you ever work abroad?", "Have you ever worked abroad?", "Do you ever work abroad?"], "answer": 1}
                    ]
                  }
                },
                {
                  "phase": "grammar",
                  "type": "grammar_rule",
                  "content": {
                    "title": "Present Perfect vs Past Simple",
                    "explanation": "El present perfect (have/has + participio) habla de experiencias sin tiempo concreto, acciones que continúan hasta hoy o resultados recientes. El past simple habla de acciones terminadas en un momento concreto del pasado.",
                    "table": {
                      "headers": ["", "Present perfect", "Past simple"],
                      "rows": [
                        ["Uso", "Experiencia / hasta ahora", "Momento terminado"],
                        ["Marcadores", "ever, never, just, yet, for, since", "yesterday, in 2019, last year, ago"],
                        ["Ejemplo", "I've worked here for 5 years.", "I worked there in 2019."]
                      ]
                    },
                    "examples": ["Have you ever been to London?", "I went to London last year.", "She's just finished the report."]
                  }
                },
                {
                  "phase": "practice",
                  "type": "fill_blanks",
                  "content": {
                    "instructions": "Elige present perfect o past simple.",
                    "items": [
                      {"sentence": "I ___ (work) in Dublin in 2019.", "answers": [["worked"]]},
                      {"sentence": "She ___ (be) a manager since 2020.", "answers": [["has been", "'s been"]], "explanation": "Since → present perfect."},
                      {"sentence": "___ you ever ___ (lead) a team?", "answers": [["Have"], ["led"]]},
                      {"sentence": "We ___ (finish) the project two weeks ago.", "answers": [["finished"]]}
                    ]
                  }
                },
                {
                  "phase": "practice",
                  "type": "word_order",
                  "content": {
                    "instructions": "Ordena la frase de la entrevista.",
                    "items": [
                      {"answer": "I have worked here for five years", "distractors": ["since"]},
                      {"answer": "Have you ever worked abroad?"}
                    ]
                  }
                },
                {
                  "phase": "production",
                  "type": "translation",
                  "content": {
                    "instructions": "Traduce al inglés.",
                    "items": [
                      {"source": "He trabajado en ventas durante tres años.", "answers": ["I've worked in sales for three years", "I have worked in sales for three years", "I've been working in sales for three years", "I have been working in sales for three years"]},
                      {"source": "Viví en Londres en 2018.", "answers": ["I lived in London in 2018"]}
                    ]
                  }
                },
                {
                  "phase": "production",
                  "type": "speaking",
                  "content": {
                    "instructions": "Responde en voz alta como en una entrevista.",
                    "items": [
                      {"text": "I've worked in customer service for five years."},
                      {"text": "I've just finished an important project."}
                    ]
                  }
                },
                {
                  "phase": "vocabulary",
                  "type": "vocabulary_table",
                  "content": {
                    "items": [
                      {"term": "Experience", "definition": "Knowledge from doing a job", "translation": "Experiencia", "example": "I have five years of experience."},
                      {"term": "Manage a team", "definition": "Be responsible for a group of workers", "translation": "Dirigir un equipo", "example": "I managed a team of six."},
                      {"term": "Abroad", "definition": "In another country", "translation": "En el extranjero", "example": "Have you ever worked abroad?"},
                      {"term": "Skills", "definition": "Abilities you have", "translation": "Habilidades", "example": "My communication skills are strong."},
                      {"term": "Strengths", "definition": "Your best qualities", "translation": "Puntos fuertes", "example": "What are your main strengths?"}
                    ]
                  }
                },
                {
                  "phase": "review",
                  "type": "speed_quiz",
                  "content": {
                    "instructions": "¡Contrarreloj!",
                    "time_limit_seconds": 40,
                    "items": [
                      {"question": "I ___ here since 2021.", "options": ["worked", "have worked", "work"], "answer": 1},
                      {"question": "She ___ the company last year.", "options": ["joined", "has joined", "joins"], "answer": 0},
                      {"question": "\"En el extranjero\" =", "options": ["abroad", "away", "outside"], "answer": 0},
                      {"question": "___ you ever been to Japan?", "options": ["Did", "Have", "Are"], "answer": 1}
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
