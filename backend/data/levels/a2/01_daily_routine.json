          "unit_id": "daily_routine",
          "title": "A Busy Week",
          "description": "Rutinas frente a lo que pasa ahora: present simple y present continuous. Y los phrasal verbs del día a día: get up, look for, put on, turn off.",
          "lessons": [
            {
              "lesson_id": "routine_present_simple",
              "title": "Present simple vs present continuous",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "A busy week",
                    "dialogue": [
                      {
                        "speaker": "Priya",
                        "text": "Lucía, what are you doing? You're wearing my slippers!"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Oh no, sorry! I'm looking for my keys, and I can't find my shoes."
                      },
                      {
                        "speaker": "Priya",
                        "text": "You usually leave your keys on the table by the door."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "I know, but they aren't there today. Is Sam using them?"
                      },
                      {
                        "speaker": "Sam",
                        "text": "Nope. I'm making toast. I never touch other people's keys!"
                      },
                      {
                        "speaker": "Priya",
                        "text": "Well, you usually take my milk…"
                      },
                      {
                        "speaker": "Sam",
                        "text": "That's different! Anyway, why are you running around? You don't start work until nine."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "This week I'm starting at eight. We're working on a big project for a new client."
                      },
                      {
                        "speaker": "Priya",
                        "text": "Here they are! Your keys are in the fridge."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "In the fridge? I need more sleep!"
                      },
                      {
                        "speaker": "Sam",
                        "text": "You need a coffee. Here, take this one. I'm not drinking it."
                      }
                    ],
                    "passage": "It's Tuesday morning, early October. The kitchen at Clifton Road is very busy today."
                  }
                },
