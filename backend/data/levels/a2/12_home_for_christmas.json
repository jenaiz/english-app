          "unit_id": "home_for_christmas",
          "title": "Home for Christmas",
          "description": "Lo que acabas de hacer, lo que ya has hecho y lo que aún no: just, already, yet. Además, something / anything / nothing y el infinitivo de finalidad (to + verbo).",
          "lessons": [
            {
              "lesson_id": "home_for_christmas_lesson",
              "title": "Present perfect: just, already, yet",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "Home for Christmas",
                    "dialogue": [
                      {
                        "speaker": "Priya",
                        "text": "Have you packed yet?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Yes, I've already packed my clothes. But I haven't found my passport yet!"
                      },
                      {
                        "speaker": "Sam",
                        "text": "Have you looked in the fridge? Your keys were there in October!"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Very funny, Sam. Oh, here it is! It was in my coat."
                      },
                      {
                        "speaker": "Priya",
                        "text": "Have you checked in online?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Yes, I've just done it. And I've already ordered a taxi."
                      },
                      {
                        "speaker": "Sam",
                        "text": "We've got something for you. Open it!"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "A new umbrella! A red one! Thank you!"
                      },
                      {
                        "speaker": "Priya",
                        "text": "Now you've got your own umbrella. No more broken black ones!"
                      },
                      {
                        "speaker": "Sam",
                        "text": "Has Daniel called you today?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "He's just sent me a message. He wants a photo of the sea!"
                      },
                      {
                        "speaker": "Priya",
                        "text": "The taxi has just arrived. Go! Merry Christmas!"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Merry Christmas! See you in January!"
                      }
                    ],
                    "passage": "It's the twentieth of December. Lucía's flight to Valencia leaves at two o'clock, and it's already eleven."
                  }
                },
