              "title": "Superlatives",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "Quiz night",
                    "dialogue": [
                      {
                        "speaker": "Quizmaster",
                        "text": "Question five. What is the longest river in the world?"
                      },
                      {
                        "speaker": "Daniel",
                        "text": "The Nile, I think. Or is it the Amazon?"
                      },
                      {
                        "speaker": "Priya",
                        "text": "The Nile. Write it down!"
                      },
                      {
                        "speaker": "Quizmaster",
                        "text": "Question six. Which is the biggest city in Ireland?"
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Easy! Dublin. It's the biggest and the most expensive."
                      },
                      {
                        "speaker": "Sam",
                        "text": "And Galway is the best, right?"
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Of course. It's the most beautiful place in the world!"
                      },
                      {
                        "speaker": "Quizmaster",
                        "text": "Question seven. What is the most popular hot drink in Britain?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Tea! Priya drinks the most tea in the house."
                      },
                      {
                        "speaker": "Priya",
                        "text": "That's not true. Sam drinks the most coffee!"
                      },
                      {
                        "speaker": "Quizmaster",
                        "text": "And the winners tonight are… The Clifton Brains!"
                      },
                      {
                        "speaker": "Sam",
                        "text": "Yes! This is the best night of the year!"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "And I won something in English for the first time!"
                      }
                    ],
                    "passage": "It's Thursday, quiz night at The Old Duke. Lucía, Sam, Priya and Daniel are a team. Their name is \"The Clifton Brains\"."
                  }
                },
