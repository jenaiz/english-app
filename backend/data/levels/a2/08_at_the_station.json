            {
              "lesson_id": "at_the_station_lesson",
              "title": "will for decisions, offers and predictions",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "At the station",
                    "dialogue": [
                      {
                        "speaker": "Lucía",
                        "text": "Oh no! The tickets are for next Saturday, not today!"
                      },
                      {
                        "speaker": "Priya",
                        "text": "What? OK, don't panic. I'll go and ask at the ticket office."
                      },
                      {
                        "speaker": "Agent",
                        "text": "Good morning. How can I help?"
                      },
                      {
                        "speaker": "Priya",
                        "text": "We've got tickets for the wrong day. Can we change them?"
                      },
                      {
                        "speaker": "Agent",
                        "text": "Let me see… Yes, you can, but it will cost ten pounds each."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "That's fine. I'll pay. It was my mistake."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Then I'll pay for the coffees."
                      },
                      {
                        "speaker": "Agent",
                        "text": "The next train to London leaves at nine fifteen from platform five."
                      },
                      {
                        "speaker": "Priya",
                        "text": "Will it be busy?"
                      },
                      {
                        "speaker": "Agent",
                        "text": "I think it will be quite busy. It's Saturday."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "We won't find three seats together, then."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Never mind. I'll stand. I'm too happy to sit down!"
                      }
                    ],
                    "passage": "Saturday morning at Bristol Temple Meads station. Lucía has the tickets on her phone, but there's a problem."
                  }
                },
                {
                  "phase": "discovery",
                  "type": "multiple_choice",
                  "content": {
