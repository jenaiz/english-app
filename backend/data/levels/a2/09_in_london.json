              "lesson_id": "in_london_lesson",
              "title": "Present perfect: experiences",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "A day in London",
                    "dialogue": [
                      {
                        "speaker": "Daniel",
                        "text": "Have you ever been to London before, Lucía?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "No, never. I've seen it in films, but I've never been here."
                      },
                      {
                        "speaker": "Priya",
                        "text": "I've been here many times. My aunt lives in Wembley."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Have you ever tried pie and mash?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "No, I haven't. What is it?"
                      },
                      {
                        "speaker": "Daniel",
                        "text": "It's a very old London dish. I've eaten it once. I didn't like it!"
                      },
                      {
                        "speaker": "Priya",
                        "text": "Have you seen the Tower of London? It's just there."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Wow! It's beautiful. I've taken a hundred photos today."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Javi will want all of them!"
                      },
                      {
                        "speaker": "Priya",
                        "text": "Have you two ever been on the London Eye?"
                      },
                      {
                        "speaker": "Daniel",
                        "text": "I have. I went on it last year, with my mam."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "I haven't. Can we go?"
                      },
                      {
                        "speaker": "Priya",
                        "text": "Of course. Let's go!"
                      }
                    ],
                    "passage": "Saturday afternoon in London. The three friends are walking along the river near Tower Bridge."
                  }
