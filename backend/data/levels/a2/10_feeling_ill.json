        {
          "unit_id": "feeling_ill",
          "title": "Feeling Ill",
          "description": "Da consejos y habla de obligaciones con should y have to. Y los condicionales cero y primero: If you rest, you'll feel better.",
          "lessons": [
            {
              "lesson_id": "feeling_ill_lesson",
              "title": "should and have to",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "Feeling ill",
                    "dialogue": [
                      {
                        "speaker": "Priya",
                        "text": "You look terrible! What's wrong?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "I've got a cold, I think. My throat hurts and I've got a headache."
                      },
                      {
                        "speaker": "Priya",
                        "text": "You should go back to bed. And you shouldn't go to work today."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "But I have to finish the designs for the new client."
                      },
                      {
                        "speaker": "Priya",
                        "text": "You don't have to finish them today. Helen will understand."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Should I take something?"
                      },
                      {
                        "speaker": "Priya",
                        "text": "Take some paracetamol and drink a lot of water. Hot tea with honey and lemon is good too."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Do I have to see a doctor?"
                      },
                      {
                        "speaker": "Priya",
                        "text": "No, you don't. It's just a cold. But you have to rest."
                      },
                      {
                        "speaker": "Sam",
                        "text": "I'm going to make you my grandma's chicken soup. It's the best medicine in Bristol!"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Thank you both. You're the best flatmates in the world."
                      }
                    ],
                    "passage": "December. Lucía wakes up with a sore throat and a headache. Priya comes home after a night shift at the hospital."
                  }
                },
                {
                  "phase": "discovery",
                  "type": "multiple_choice",
                  "content": {
