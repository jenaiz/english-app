              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "Old photos",
                    "dialogue": [
                      {
                        "speaker": "Sam",
                        "text": "Who's that little girl with the big ice cream?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "That's me! I was six. We went to the beach every summer."
                      },
                      {
                        "speaker": "Sam",
                        "text": "Did you live near the sea?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Yes, we did. Our flat was ten minutes from the beach."
                      },
                      {
                        "speaker": "Sam",
                        "text": "Lucky you! I grew up in Bristol, so I didn't see the sea very often."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Did you play music when you were a child?"
                      },
                      {
                        "speaker": "Sam",
                        "text": "Yes. My dad gave me a guitar when I was eight. I didn't practise much, but I loved it."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "And did you go to university?"
                      },
                      {
                        "speaker": "Sam",
                        "text": "No, I didn't. I started working in a pub when I was eighteen. What about you?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "I studied design in Valencia. Then I worked in Madrid for three years."
                      },
                      {
                        "speaker": "Sam",
                        "text": "Why did you leave Spain?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "I wanted a new adventure. And my English was terrible!"
                      },
                      {
                        "speaker": "Sam",
                        "text": "Well, it isn't terrible now."
                      }
                    ],
                    "passage": "One rainy Sunday evening, Sam finds Lucía on the sofa with some old photos from Valencia."
                  }
                },
