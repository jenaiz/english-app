          "unit_id": "a_bad_day",
          "title": "What a Morning!",
          "description": "Cuenta qué estabas haciendo cuando pasó algo: past continuous y past simple. Además, cómo contar una historia: first, then, after that, finally y adverbios como quickly.",
          "lessons": [
            {
              "lesson_id": "a_bad_day_lesson",
              "title": "Past continuous vs past simple",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "What a morning!",
                    "dialogue": [
                      {
                        "speaker": "Daniel",
                        "text": "Lucía! Are you OK? What happened?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "What a morning! I was walking to the bus stop when it started to rain."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Oh no. Didn't you have your umbrella?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Yes, but while I was opening it, the wind broke it!"
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Sam's famous black umbrella? Not again!"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Then, when I was getting on the bus, a man ran into me and my coffee went everywhere."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "That's terrible. And what were you doing when Helen called? She was looking for you at nine."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "I was sitting on the bus. I couldn't hear my phone."
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Don't worry. She wasn't angry. She was talking to a client all morning."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Thank goodness. Is there any coffee in the kitchen?"
                      },
                      {
                        "speaker": "Daniel",
                        "text": "Sit down. I can make you one."
                      }
                    ],
                    "passage": "Monday morning, late October. Lucía arrives at Harbour Studio twenty minutes late. Her hair is wet and there's coffee on her new coat."
                  }
                },
                {
                  "phase": "discovery",
