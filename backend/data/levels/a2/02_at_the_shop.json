          "unit_id": "at_the_shop",
          "title": "A Coat for the Winter",
          "description": "De compras: contables e incontables, how much / how many, a lot of y too. Y all, both, none, most y enough.",
          "lessons": [
            {
              "lesson_id": "shop_prices",
              "title": "How much? How many? A lot of, too",
              "steps": [
                {
                  "phase": "context",
                  "type": "audio_context",
                  "content": {
                    "title": "A coat for the winter",
                    "dialogue": [
                      {
                        "speaker": "Priya",
                        "text": "How much money do you want to spend?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Not much! I don't have a lot of money this month."
                      },
                      {
                        "speaker": "Shop assistant",
                        "text": "Hello! Can I help you?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Yes, please. I'm looking for a winter coat. How much is this blue one?"
                      },
                      {
                        "speaker": "Shop assistant",
                        "text": "It's eighty-five pounds. But there are a lot of coats in the sale over there."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Can I try this one on?"
                      },
                      {
                        "speaker": "Shop assistant",
                        "text": "Of course. What size are you?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Medium, I think."
                      },
                      {
                        "speaker": "Priya",
                        "text": "How many coats do you want to try?"
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Just two or three! Oh, it's too big. Have you got it in a small?"
                      },
                      {
                        "speaker": "Shop assistant",
                        "text": "Let me check… Yes, here you are."
                      },
                      {
                        "speaker": "Lucía",
                        "text": "Perfect. And it's only forty pounds in the sale!"
                      },
                      {
                        "speaker": "Priya",
                        "text": "Great. Now we've got some money for a hot chocolate."
                      }
                    ],
                    "passage": "On Saturday, Lucía and Priya go to Cabot Circus, a big shopping centre in the city. Lucía needs a warm coat for the winter."
                  }
                },
