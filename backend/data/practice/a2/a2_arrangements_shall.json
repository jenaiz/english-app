          "Intención",
          "I'm going to visit the museum."
        ],
        [
          "Preguntar por planes",
          "What are you doing on Saturday?"
        ],
        [
          "Sugerencia",
          "Shall we take the train?"
        ],
        [
          "Ofrecerse",
          "Shall I book the tickets?"
        ]
      ]
    }
  },
